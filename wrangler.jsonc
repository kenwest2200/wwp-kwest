{
	"name": "waterway-frontend",
	"account_id": "b5276468e906e2275dc13fc5426090e6",
	"compatibility_date": "2026-03-26",
	"main": "src/worker.ts",
	"assets": {
	  "directory": "./dist",
	  "binding": "ASSETS"
	},
	"env": {
	  "dev": {
		"name": "waterway-frontend-dev",
		// Route every request (incl. static files) through the worker so the
		// Basic Auth gate in src/worker.ts also protects pages, not only /api/*.
		"assets": {
		  "directory": "./dist",
		  "binding": "ASSETS",
		  "run_worker_first": true
		}
	  },
	  "stage": {
		"name": "waterway-frontend-stage"
	  }
	}
  }