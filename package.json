{
  "name": "p-job-wwp-kwest",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev --env dev",
    "clean:build": "node ./scripts/clean-build-output.mjs",
    "build": "npm run clean:build && npm run generate:product-filters-data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:product-filters-data": "node ./scripts/generate-product-filters-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.3",
    "@astrojs/node": "^10.0.3",
    "astro": "^6.1.7",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "wrangler": "^4.77.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}