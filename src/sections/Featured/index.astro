---

<section class="featured" aria-labelledby="featured-heading">
  <div class="container featured__container">
    <SectionTitle
      title={sectionTitle?.trim() || "Featured Products"}
      className="featured__title"
    />
    <ul class="featured__grid">
      {
        items.map((item) => (
          <li class="featured__item">
            <p class="featured__item-label">{item.categoryLabel}</p>

            {item.imageUrl ? (
              <img
                src={
                  typeof item.imageUrl === "string"
                    ? item.imageUrl
                    : item.imageUrl.src
                }
                alt={item.imageAlt}
                class="featured__item-image"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <h3 class="featured__item-title">{item.title}</h3>
            <a
              href={item.href}
              class="btn btn--single-outline featured__item-link"
            >
              View details
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
