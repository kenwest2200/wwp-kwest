---
import type { ImageMetadata } from "astro";
import SectionTitle from "../../components/SectionTitle/index.astro";
import {
  getFeaturedProductsSection,
  type HomeFeaturedData,
  type HomepageFeaturedProduct,
} from "../../lib/queries/home-featured";
// import img1 from "../../assets/images/f1.png";
// import img2 from "../../assets/images/f2.png";
// import img3 from "../../assets/images/f3.png";
// import img4 from "../../assets/images/f4.png";

interface Props {
  data: HomeFeaturedData | null;
}

const { data } = Astro.props;

type FeaturedCard = {
  categoryLabel: string;
  title: string;
  imageUrl: string | ImageMetadata;
  imageAlt: string;
  href: string;
};

function productHref(url: string | null | undefined): string {
  const raw = url?.trim();
  if (!raw) {
    return "#";
  }
  if (raw.startsWith("http://") || raw.startsWith("https://")) {
    return raw;
  }
  const path = raw.replace(/^\/+/, "");
  return `/${path}`;
}

function mapFromHomepageProducts(
  products: HomepageFeaturedProduct[],
): FeaturedCard[] {
  return products
    .filter((p) => p.title?.trim())
    .map((p) => {
      const title = (p.title ?? "").trim();
      const category = p.productCategory?.trim();
      return {
        categoryLabel: category || "Product",
        title,
        imageUrl: p.image?.trim() ?? "",
        imageAlt: title,
        href: productHref(p.productUrl),
      };
    });
}

const { sectionTitle, products } = getFeaturedProductsSection(data);
const items = mapFromHomepageProducts(products);

