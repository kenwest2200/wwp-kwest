---
import type { ImageMetadata } from "astro";
import SectionTitle from "../../components/SectionTitle/index.astro";
import { decodeHtmlEntities } from "../../lib/decode-html-entities";
import {
  getFeaturedProductsSection,
  type HomeFeaturedData,
  type HomepageFeaturedProduct,
} from "../../lib/queries/home-featured";
// import img1 from "../../assets/images/f1.png";
// import img2 from "../../assets/images/f2.png";
// import img3 from "../../assets/images/f3.png";
// import img4 from "../../assets/images/f4.png";

interface Props {
  data: HomeFeaturedData | null;
}

const { data } = Astro.props;

type FeaturedCard = {
  categoryLabel: string;
  title: string;
  imageUrl: string | ImageMetadata;
  imageAlt: string;
  href: string;
};

function productHref(url: string | null | undefined): string {
  const raw = url?.trim();
  if (!raw) {
    return "#";
  }
  if (raw.startsWith("http://") || raw.startsWith("https://")) {
    return raw;
  }
  const path = raw.replace(/^\/+/, "");
  return `/${path}`;
}

function mapFromHomepageProducts(
  products: HomepageFeaturedProduct[],
): FeaturedCard[] {
  return products
    .filter((p) => p.title?.trim())
    .map((p) => {
      const title = decodeHtmlEntities((p.title ?? "").trim());
      const categoryRaw = p.productCategory?.trim();
      const categoryLabel = decodeHtmlEntities(categoryRaw || "Product");
      return {
        categoryLabel,
        title,
        imageUrl: p.image?.trim() ?? "",
        imageAlt: title,
        href: productHref(p.productUrl),
      };
    });
}

const { sectionTitle, products } = getFeaturedProductsSection(data);
const items = mapFromHomepageProducts(products);
const sectionHeading = sectionTitle?.trim()
  ? decodeHtmlEntities(sectionTitle.trim())
  : "Featured Products";
---

<section class="featured" aria-labelledby="featured-heading">
  <div class="container featured__container">
    <SectionTitle title={sectionHeading} className="featured__title" />
    <ul class="featured__grid">
      {
        items.map((item) => (
          <li class="featured__item" data-full-title={item.title}>
            <p class="featured__item-label">{item.categoryLabel}</p>

            {item.imageUrl ? (
              <img
                src={
                  typeof item.imageUrl === "string"
                    ? item.imageUrl
                    : item.imageUrl.src
                }
                alt={item.imageAlt}
                class="featured__item-image"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <h3 class="featured__item-title">{item.title}</h3>
            <a
              href={item.href}
              class="btn btn--single-outline featured__item-link"
            >
              View details
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import "../../scripts/featured-section.ts";
</script>
