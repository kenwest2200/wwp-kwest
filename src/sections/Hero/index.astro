---
import {
  normalizeHeroImageObjectFit,
  type HomeHeroData,
  type HeroImageObjectFit,
  type HomepageApiSectionsIntroSectionLayout,
} from "../../lib/queries/home-hero";
import IconArrowRight from "../../components/icons/IconArrowRight.astro";
import Picture from "../../components/Picture/Picture.astro";
import { pictureFromWpMediaNode } from "../../lib/picture-wp-media";

interface Props {
  data: HomeHeroData | null;
}

const { data } = Astro.props;

const node = data?.nodeByUri ?? null;
const sections = node?.template?.homepageApi?.sections ?? [];

function isIntroSection(
  s: (typeof sections)[number],
): s is HomepageApiSectionsIntroSectionLayout {
  return s?.__typename === "HomepageApiSectionsIntroSectionLayout";
}

const intro = sections.find(isIntroSection) ?? null;

const title = intro?.title ?? null;
const description = intro?.description ?? null;

const fallbackImageAlt = title ?? "Hero image";

type HeroPictureSlot = {
  pic: NonNullable<ReturnType<typeof pictureFromWpMediaNode>>;
  fit: HeroImageObjectFit;
  index: number;
};

const heroPictureSlots: HeroPictureSlot[] = (
  [
    { node: intro?.image1?.node, fit: intro?.image1Fit },
    { node: intro?.image2?.node, fit: intro?.image2Fit },
    { node: intro?.image3?.node, fit: intro?.image3Fit },
  ] as const
)
  .map(({ node, fit }, index) => {
    const pic = pictureFromWpMediaNode(node, fallbackImageAlt);
    if (!pic) return null;
    return {
      pic,
      fit: normalizeHeroImageObjectFit(fit),
      index,
    };
  })
  .filter((x): x is HeroPictureSlot => x !== null);

const buttonLink = intro?.buttonLink ?? null;
const rawCtaHref = buttonLink?.url?.trim() || "#";
const ctaHref =
  rawCtaHref === "/products" || rawCtaHref === "/products/"
    ? "/products/?catalog=root"
    : rawCtaHref;
const ctaLabel = buttonLink?.title?.trim() || "Browse catalog";
const ctaTarget = buttonLink?.target?.trim();
const ctaRel = ctaTarget === "_blank" ? "noopener noreferrer" : undefined;

const fallbackTitle = "Engineered for Pool, Spa & Bath";
const fallbackDescription =
  "Cross-compatible components designed in USA for distributors, installers, and inspectors.";
---

<section class="hero" data-page-header-offset>
  <div class="container hero__container">
    <div class="hero__content">
      <div class="hero__content-inner">
        <h1 class="hero__title">{title || fallbackTitle}</h1>
        {
          description ? (
            <div class="hero__description" set:html={description} />
          ) : (
            <p class="hero__description">{fallbackDescription}</p>
          )
        }
      </div>
      {
        buttonLink?.url?.trim() ? (
          <div class="hero__buttons">
            <a
              href={ctaHref}
              class="btn btn--primary hero__button hero__button--primary"
              target={ctaTarget}
              rel={ctaRel}
            >
              {ctaLabel}
              <IconArrowRight />
            </a>
          </div>
        ) : null
      }
    </div>
    {
      heroPictureSlots.length > 0 && (
        <div class="hero__image-container">
          {heroPictureSlots.map(({ pic, fit, index }) => (
            <Picture
              class="hero__picture"
              alt={pic.alt}
              sources={pic.sources}
              img={{
                ...pic.img,
                loading: index === 0 ? "eager" : "lazy",
                fetchpriority: index === 0 ? "high" : "low",
                decoding: "async",
                class: `hero__image hero__image--${index} hero__image--fit-${fit}`,
              }}
            />
          ))}
        </div>
      )
    }
  </div>
</section>
