---
import CloseButtonIcon from "../icons/closeButtonIcon.astro";
---

<div
  id="product-filters-overflow-modal"
  class="product-filters__overflow-modal"
  aria-hidden="true"
  hidden
>
  <div
    class="product-filters__overflow-modal-backdrop"
    data-overflow-modal-close
  >
  </div>
  <div
    class="product-filters__overflow-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="product-filters-overflow-modal-title"
  >
    <div class="product-filters__overflow-modal-head">
      <button
        type="button"
        class="product-filters__overflow-modal-back"
        aria-label="Back"
        data-overflow-modal-back
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="12"
          height="8"
          viewBox="0 0 12 8"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 1L1 4M1 4L4 7M1 4H11"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back
      </button>
      <h3
        id="product-filters-overflow-modal-title"
        class="product-filters__overflow-modal-title"
      >
      </h3>
      <button
        type="button"
        class="product-filters__overflow-modal-close"
        aria-label="Close"
        data-overflow-modal-close
      >
        <CloseButtonIcon class="product-filters__overflow-modal-close-icon" />
      </button>
    </div>
    <label class="product-filters__overflow-modal-search-label">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="17"
        viewBox="0 0 16 17"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M7.33333 13.1667C10.2789 13.1667 12.6667 10.7789 12.6667 7.83333C12.6667 4.88781 10.2789 2.5 7.33333 2.5C4.38781 2.5 2 4.88781 2 7.83333C2 10.7789 4.38781 13.1667 7.33333 13.1667Z"
          fill="#A0A8AF"></path>
        <path
          d="M14 14.5L11.1 11.6"
          stroke="#A0A8AF"
          stroke-width="1.2"
          stroke-linecap="round"></path>
      </svg>
      <input
        id="product-filters-overflow-modal-search"
        class="product-filters__overflow-modal-search-input"
        type="search"
        placeholder="Search"
      />
      <button
        type="button"
        id="product-filters-overflow-modal-search-clear"
        class="product-filters__overflow-modal-search-clear"
        aria-label="Clear search"
        hidden
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M12 4L4 12"
            stroke="#9C9C9C"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M4 4L12 12"
            stroke="#9C9C9C"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </label>
    <div
      id="product-filters-overflow-modal-list"
      class="product-filters__overflow-modal-list"
    >
    </div>
  </div>
</div>
