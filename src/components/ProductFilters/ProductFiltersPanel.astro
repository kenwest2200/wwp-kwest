---
import SectionTitle from "../SectionTitle/index.astro";
import IconSearch from "../icons/searchIcon.astro";
import IconArrowDown from "../icons/arrowDown.astro";
import IconGridRows from "../icons/gridRowsIcon.astro";
import IconGridList from "../icons/gridListIcon.astro";
import ArrowPaginationIcon from "../icons/arrowPaginationIcon.astro";
import CloseButtonIcon from "../icons/closeButtonIcon.astro";
import ProductFiltersOverflowModal from "./ProductFiltersOverflowModal.astro";
---

<section
  id="product-filters-catalog"
  class="product-filters-catalog"
  aria-label="Filters and product list"
>
  <SectionTitle
    title="Explore our products"
    className="product-filters-catalog__section-title"
  />

  <div class="product-filters-catalog__inner">
    <div class="product-filters__layout">
      <div
        id="product-filters-drawer-backdrop"
        class="product-filters__drawer-backdrop"
        aria-hidden="true"
      >
      </div>
      <div
        id="product-filters-filters-panel"
        class="product-filters__panel product-filters__panel--filters"
        aria-labelledby="product-filters-heading"
      >
        <button
          type="button"
          id="product-filters-drawer-close"
          class="product-filters__drawer-close"
          aria-label="Close filters"
        >
          <CloseButtonIcon class="product-filters__drawer-close-icon" />
        </button>
        <h2 id="product-filters-heading" class="product-filters__filters-title">
          Filtering by:
        </h2>
        <p id="product-filters-api-error" class="product-filters__err" hidden>
        </p>

        <div class="product-filters__group product-filters__group--search">
          <label
            class="product-filters__search-label"
            for="product-filters-search"
          >
            <IconSearch />
            <input
              id="product-filters-search"
              type="search"
              class="product-filters__search-input"
              placeholder="Search"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
        </div>

        <div class="product-filters__filter-actions" aria-live="polite">
          <p
            id="product-filters-no-filters-label"
            class="product-filters__no-filters-label"
          >
            No filters applied
          </p>
          <button
            type="button"
            id="product-filters-clear"
            class="product-filters__btn product-filters__filters-clear-all"
            hidden
          >
            Clear all
          </button>
        </div>

        <div class="product-filters__group product-filters__accordion">
          <button
            type="button"
            class="product-filters__accordion-trigger"
            id="product-filters-cat-trigger"
            aria-expanded="true"
            aria-controls="product-filters-cat-panel"
          >
            <span class="product-filters__accordion-title">Categories</span>
            <span class="product-filters__accordion-chevron" aria-hidden="true">
              <span class="product-filters__accordion-chevron-icon"></span>
            </span>
          </button>
          <div
            id="product-filters-cat-panel"
            class="product-filters__accordion-panel"
            role="region"
            aria-labelledby="product-filters-cat-trigger"
          >
            <div class="product-filters__accordion-panel-inner">
              <div
                id="product-filters-root"
                class="product-filters__root-mount product-filters__chips product-filters__chips--row"
              >
              </div>
            </div>
          </div>
        </div>

        <div class="product-filters__group product-filters__accordion">
          <button
            type="button"
            class="product-filters__accordion-trigger"
            id="product-filters-sub-trigger"
            aria-expanded="true"
            aria-controls="product-filters-sub-panel"
          >
            <span class="product-filters__accordion-title">Product types</span>
            <span class="product-filters__accordion-chevron" aria-hidden="true">
              <span class="product-filters__accordion-chevron-icon"></span>
            </span>
          </button>
          <div
            id="product-filters-sub-panel"
            class="product-filters__accordion-panel"
            role="region"
            aria-labelledby="product-filters-sub-trigger"
          >
            <div class="product-filters__accordion-panel-inner">
              <div
                id="product-filters-sub"
                class="product-filters__sub-panels product-filters__chips product-filters__chips--row"
              >
              </div>
              <div class="product-filters__sub-more-row">
                <button
                  type="button"
                  id="product-filters-sub-more"
                  class="product-filters__link-btn"
                  hidden
                >
                  Show all
                  <IconArrowDown />
                </button>
                <button
                  type="button"
                  id="product-filters-sub-less"
                  class="product-filters__link-btn"
                  hidden
                >
                  Hide
                  <IconArrowDown
                    class="product-filters__link-btn-icon product-filters__link-btn-icon--rotate"
                  />
                </button>
              </div>
            </div>
          </div>
        </div>

        <section
          id="product-filters-attrs-section"
          class="product-filters__attrs-section"
          aria-label="Attribute filters"
          hidden
        >
          <div id="product-filters-attrs" class="product-filters__attrs"></div>
        </section>
      </div>

      <div class="product-filters__panel">
        <div class="product-filters__products-toolbar-wrapper">
          <div class="product-filters__products-toolbar">
            <div
              id="product-filters-per-dropdown"
              class="product-filters__custom-select"
            >
              <button
                type="button"
                id="product-filters-per-trigger"
                class="product-filters__custom-select-trigger"
                aria-label="Products per page"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="product-filters-per-menu"
              >
                <span class="product-filters__custom-select-text">
                  <span class="product-filters__custom-select-fixed">Show:</span
                  >
                  <span
                    id="product-filters-per-value"
                    class="product-filters__custom-select-variable">24</span
                  >
                  <span class="product-filters__custom-select-variable"
                    >/ page</span
                  >
                </span>
                <span
                  class="product-filters__custom-select-chevron"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                  >
                    <path
                      d="M0.75 0.75L4.75 4.75L8.75 0.75"
                      stroke="#9C9C9C"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </span>
              </button>
              <ul
                id="product-filters-per-menu"
                class="product-filters__custom-select-menu"
                role="listbox"
                aria-labelledby="product-filters-per-trigger"
                hidden
              >
                <li role="presentation">
                  <button
                    type="button"
                    class="product-filters__custom-select-option"
                    role="option"
                    data-per-value="12"
                  >
                    12
                  </button>
                </li>
                <li role="presentation">
                  <button
                    type="button"
                    class="product-filters__custom-select-option"
                    role="option"
                    data-per-value="24"
                  >
                    24
                  </button>
                </li>
              </ul>
            </div>
            <div
              id="product-filters-sort-dropdown"
              class="product-filters__custom-select"
            >
              <button
                type="button"
                id="product-filters-sort-trigger"
                class="product-filters__custom-select-trigger"
                aria-label="Sort products"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="product-filters-sort-menu"
              >
                <span class="product-filters__custom-select-text">
                  <span class="product-filters__custom-select-fixed"
                    >Sort by:</span
                  >
                  <span
                    id="product-filters-sort-value"
                    class="product-filters__custom-select-variable">Newest</span
                  >
                </span>
                <span
                  class="product-filters__custom-select-chevron"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                  >
                    <path
                      d="M0.75 0.75L4.75 4.75L8.75 0.75"
                      stroke="#9C9C9C"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </span>
              </button>
              <ul
                id="product-filters-sort-menu"
                class="product-filters__custom-select-menu"
                role="listbox"
                aria-labelledby="product-filters-sort-trigger"
                hidden
              >
                <li role="presentation">
                  <button
                    type="button"
                    class="product-filters__custom-select-option"
                    role="option"
                    data-sort-value="updated"
                  >
                    Newest
                  </button>
                </li>
                <li role="presentation">
                  <button
                    type="button"
                    class="product-filters__custom-select-option"
                    role="option"
                    data-sort-value="name-asc"
                  >
                    A–Z
                  </button>
                </li>
                <li role="presentation">
                  <button
                    type="button"
                    class="product-filters__custom-select-option"
                    role="option"
                    data-sort-value="name-desc"
                  >
                    Z–A
                  </button>
                </li>
              </ul>
            </div>
            <div
              class="product-filters__layout-toggle"
              role="group"
              aria-label="Product layout"
            >
              <button
                type="button"
                id="product-filters-view-grid"
                class="product-filters__layout-toggle-btn"
                aria-pressed="true"
              >
                <IconGridRows />
              </button>
              <button
                type="button"
                id="product-filters-view-rows"
                class="product-filters__layout-toggle-btn"
                aria-pressed="false"
              >
                <IconGridList />
              </button>
            </div>
          </div>
          <div
            class="product-filters__toolbar-pager"
            aria-label="Page navigation"
          >
            <p
              id="product-filters-products-total"
              class="product-filters__products-total"
            >
              Products found: 0
            </p>
            <div class="product-filters__toolbar-pager-buttons">
              <button
                type="button"
                id="product-filters-prev-toolbar"
                class="product-filters__btn product-filters__btn--prev"
              >
                <ArrowPaginationIcon
                  class="product-filters__btn-icon product-filters__btn-icon--prev"
                />
              </button>
              <button
                type="button"
                id="product-filters-next-toolbar"
                class="product-filters__btn product-filters__btn--next"
              >
                <ArrowPaginationIcon
                  class="product-filters__btn-icon product-filters__btn-icon--next"
                />
              </button>
            </div>
          </div>
          <button
            type="button"
            id="product-filters-drawer-open"
            class="product-filters__drawer-open-btn"
            aria-expanded="false"
            aria-controls="product-filters-filters-panel"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M1.33337 3.33331H14.6667"
                stroke="#007D8A"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M4 8H12"
                stroke="#007D8A"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M6 12.6667H10"
                stroke="#007D8A"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            Filter
          </button>
          <div
            id="product-filters-active-filters"
            class="product-filters__active-filters"
            hidden
          >
            <div class="product-filters__active-filters-head">
              <span
                class="product-filters__active-filters-selected-label"
                id="product-filters-active-filters-selected-label"
              >
                Selected:
              </span>
              <div
                id="product-filters-active-filters-row"
                class="product-filters__active-filters-row"
                role="group"
                aria-label="Active filters"
              >
              </div>
            </div>
            <div
              id="product-filters-active-filters-toggle"
              class="product-filters__active-filters-toggle"
              hidden
            >
              <button
                type="button"
                id="product-filters-active-filters-show"
                class="product-filters__link-btn product-filters__active-filters-toggle-btn"
              >
                Show all
              </button>
              <button
                type="button"
                id="product-filters-active-filters-hide"
                class="product-filters__link-btn product-filters__active-filters-toggle-btn"
                hidden
              >
                Hide
              </button>
            </div>
          </div>
        </div>
        <ul id="product-filters-products" class="product-filters__list"></ul>
        <p
          id="product-filters-empty"
          class="product-filters__empty"
          role="status"
          aria-live="polite"
          hidden
        >
          No product found
        </p>
        <div
          class="product-filters__pager"
          id="product-filters-pager"
          aria-label="Page navigation"
        >
          <p
            id="product-filters-pager-range"
            class="product-filters__pager-range"
          >
            —
          </p>
          <div class="product-filters__pager-controls">
            <button
              type="button"
              id="product-filters-prev"
              class="product-filters__pager-step product-filters__pager-step--prev"
            >
              <div class="product-filters__pager-step-icon-wrapper">
                <ArrowPaginationIcon
                  class="product-filters__pager-step-icon product-filters__pager-step-icon--prev"
                />
              </div>
              <span class="product-filters__pager-step-text">Previous</span>
            </button>
            <div
              id="product-filters-pager-pages"
              class="product-filters__pager-pages"
              role="presentation"
            >
            </div>
            <button
              type="button"
              id="product-filters-next"
              class="product-filters__pager-step product-filters__pager-step--next"
            >
              <span class="product-filters__pager-step-text">Next</span>
              <div class="product-filters__pager-step-icon-wrapper">
                <ArrowPaginationIcon
                  class="product-filters__pager-step-icon product-filters__pager-step-icon--next"
                />
              </div>
            </button>
          </div>
        </div>
        <button
          type="button"
          id="product-filters-load-more"
          class="btn btn--primary-dark product-filters__load-more"
          hidden
        >
          Load more products
        </button>
      </div>
    </div>
  </div>
  <ProductFiltersOverflowModal />
</section>
