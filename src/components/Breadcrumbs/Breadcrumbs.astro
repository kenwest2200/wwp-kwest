---
export type BreadcrumbItem = {
  label: string;
  href?: string;
};

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props as Props;
---

{
  items.length > 0 && (
    <nav class:list={["breadcrumbs", className]} aria-label="Breadcrumb">
      <ol class="breadcrumbs__list">
        {items.map((item, idx) => {
          const isLast = idx === items.length - 1;
          const href = item.href?.trim();
          return (
            <li
              class="breadcrumbs__item"
              aria-current={isLast ? "page" : undefined}
            >
              {idx > 0 && (
                <span class="breadcrumbs__separator" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="6"
                    height="10"
                    viewBox="0 0 6 10"
                    fill="none"
                  >
                    <path
                      d="M0.75 8.75L4.75 4.75L0.75 0.75"
                      stroke="#9C9C9C"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              )}
              {href && !isLast ? (
                <a class="breadcrumbs__link" href={href}>
                  {item.label}
                </a>
              ) : (
                <span class="breadcrumbs__current">{item.label}</span>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
