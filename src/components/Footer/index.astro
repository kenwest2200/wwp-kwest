---
import {
  type FooterLayoutData,
  footerColumnsFromMenuNodes,
} from "../../lib/queries/layout-footer";
import FooterLogo from "../icons/footerLogo.astro";
import CallIcon from "../icons/callIcon.astro";
import AppIcon from "../../assets/images/app.png";
import AppIcon2 from "../../assets/images/app2.png";
import FacebookIcon from "../icons/facebook.astro";
import InstagramIcon from "../icons/instagram.astro";
import YoutubeIcon from "../icons/youtube.astro";

interface Props {
  data?: FooterLayoutData | null;
}

const { data } = Astro.props;

/** Always append after WP menu columns (`FOOTER_MENU`). */
const footerStaticTailColumns = [
  {
    label: "Mobile Apps & Tools",
    links: [
      {
        icon: {
          url: AppIcon,
          alt: "Applications",
        },
        href: "https://apps.apple.com/us/app/waterway-pool-spa-catalog/id1210513986",
      },
      {
        icon: {
          url: AppIcon2,
          alt: "Applications",
        },
        href: "https://apps.apple.com/us/app/waterway-pool-spa-control/id1130599685",
      },
    ],
  },
  {
    label: "Join us",
    links: [
      {
        icon: "facebook" as const,
        href: "https://www.facebook.com/Waterway-Plastics-132649443445814/?ref=br_rs",
      },
      {
        icon: "instagram" as const,
        href: "https://www.instagram.com/waterwayplastics/",
      },
      {
        icon: "youtube" as const,
        href: "https://www.youtube.com/@waterwayplastics8666",
      },
    ],
  },
];

const copyrightYear = new Date().getFullYear();

const mockFooterData = {
  address: "2200 East Sturgis Road Oxnard, California 93030",
  copyright: `Copyright © 2007–${copyrightYear} Waterway Plastics, Inc. All rights reserved.`,
  buttons: [
    {
      label: "Call us 805-981-0262",
      href: "tel:+18059810262",
    },
    {
      label: "Email us",
      href: "mailto:info@waterwayplastics.com",
    },
  ],
};

const columnNodes = data?.footerColumns?.nodes ?? [];
const apiColumns = footerColumnsFromMenuNodes(columnNodes);
const displayColumns = [...apiColumns, ...footerStaticTailColumns];

function footerLinkLabelByHref(label: string, href: string): string {
  const hrefTrimmed = (href ?? "").trim().toLowerCase();
  if (
    hrefTrimmed.includes("/resources/recall/") ||
    hrefTrimmed.endsWith("/resources/recall")
  ) {
    return "Recall";
  }
  return label;
}
---

<footer class="footer">
  <div class="container footer__container">
    <div class="footer__top">
      <div class="footer__logo-block">
        <a href="/">
          <FooterLogo class="footer__logo-icon" />
        </a>
        <p class="footer__logo-text">{mockFooterData.address}</p>
      </div>
      <div class="footer__buttons">
        <a
          href={mockFooterData.buttons[0].href}
          class="btn btn--primary footer__button footer__button--call-us"
        >
          <CallIcon class="footer__button-icon" />
          <span>{mockFooterData.buttons[0].label}</span>
        </a>
        <a
          href={mockFooterData.buttons[1].href}
          class="btn btn--secondary footer__button footer__button--email-us"
        >
          <span>{mockFooterData.buttons[1].label}</span>
        </a>
      </div>
    </div>
    <div class="footer__columns">
      {
        displayColumns.map((column, index) => {
          const firstLink = column.links[0];
          const listIconModifier =
            firstLink && "icon" in firstLink
              ? "footer__column-list--with-icon"
              : "";
          return (
            <div class={`footer__column footer__column--${index + 1}`}>
              <h3 class="footer__column-title">{column.label}</h3>
              <ul class={`footer__column-list ${listIconModifier}`}>
                {column.links.map((link, linkIndex) => (
                  <li
                    class={`footer__column-item footer__column-item--${linkIndex + 1}`}
                  >
                    <a
                      href={link.href}
                      class={`footer__column-link${
                        "icon" in link && typeof link.icon === "string"
                          ? ` footer__column-link--${link.icon}`
                          : ""
                      }`}
                      {...("icon" in link && link.icon
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                      aria-label={
                        "icon" in link && typeof link.icon === "string"
                          ? link.icon
                          : undefined
                      }
                    >
                      {"icon" in link &&
                      typeof link.icon === "object" &&
                      link.icon?.url ? (
                        <img
                          src={
                            typeof link.icon.url === "string"
                              ? link.icon.url
                              : link.icon.url.src
                          }
                          alt={link.icon.alt}
                          class="footer__column-icon footer__column-icon--app"
                        />
                      ) : null}
                      {"icon" in link &&
                      typeof link.icon === "string" &&
                      link.icon === "facebook" ? (
                        <FacebookIcon class="footer__column-icon" />
                      ) : "icon" in link &&
                        typeof link.icon === "string" &&
                        link.icon === "instagram" ? (
                        <InstagramIcon class="footer__column-icon" />
                      ) : "icon" in link &&
                        typeof link.icon === "string" &&
                        link.icon === "youtube" ? (
                        <YoutubeIcon class="footer__column-icon" />
                      ) : null}
                      {"label" in link && link.label
                        ? footerLinkLabelByHref(link.label, link.href)
                        : null}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">{mockFooterData.copyright}</p>
    </div>
  </div>
</footer>
