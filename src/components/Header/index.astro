---
import type { HeaderLayoutData } from "../../lib/queries/layout-header";
import IconFacebook from "../icons/facebook.astro";
import IconInstagram from "../icons/instagram.astro";
import HeaderLogo from "../icons/headerLogo.astro";
import IconArrowRight from "../icons/IconArrowRight.astro";
import IconSearch from "../icons/searchIcon.astro";
import IconBurger from "../icons/burgerIcon.astro";
import IconClose from "../icons/closeButtonIcon.astro";
import IconTailArrowRight from "../icons/IconTailArrowRight.astro";
import IconArrowDown from "../icons/arrowDown.astro";

interface Props {
  data: HeaderLayoutData | null | undefined;
  headerType?: "white";
}

function menuNodesFromHeaderData(data: HeaderLayoutData | null | undefined) {
  const nodes = data?.menuItems?.nodes;
  return Array.isArray(nodes) ? nodes : [];
}

function topBarNodesFromHeaderData(data: HeaderLayoutData | null | undefined) {
  const nodes = data?.topBarMenuItems?.nodes;
  return Array.isArray(nodes) ? nodes : [];
}

const { data, headerType } = Astro.props;
const items = menuNodesFromHeaderData(data);
const topBarFlat = topBarNodesFromHeaderData(data);
const currentPathname = Astro.url.pathname;

type MenuLink = { label: string; href: string };
type FlatMenuNode = {
  id: string;
  label: string;
  url: string;
  path: string;
  parentId: string | null;
};
type HeaderMenuNode = {
  id: string;
  label: string;
  href: string;
  children: HeaderMenuNode[];
};

function normalizeMenuHref(pathRaw: string, urlRaw: string): string {
  const path = (pathRaw ?? "").trim();
  if (path && path !== "#") return path;
  const url = (urlRaw ?? "").trim();
  if (!url || url === "#") return "#";
  if (url.startsWith("/")) return url;
  try {
    const parsed = new URL(url);
    return parsed.pathname || "#";
  } catch {
    return "#";
  }
}

function inferParentHrefFromChildren(children: HeaderMenuNode[]): string {
  for (const child of children) {
    const href = (child.href ?? "").trim();
    if (!href || href === "#") continue;
    if (href.startsWith("/products")) return "/products";
    const parts = href.split("?")[0].split("/").filter(Boolean);
    if (parts.length > 0) return `/${parts[0]}`;
  }
  return "#";
}

function slugFromLabel(label: string): string {
  return label
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function buildHeaderMenuTree(flatNodes: FlatMenuNode[]): HeaderMenuNode[] {
  const byId = new Map<string, HeaderMenuNode>();
  const roots: HeaderMenuNode[] = [];

  flatNodes.forEach((node) => {
    if (!node.id || !node.label) return;
    const href = normalizeMenuHref(node.path, node.url);
    byId.set(node.id, {
      id: node.id,
      label: node.label,
      href,
      children: [],
    });
  });

  flatNodes.forEach((node) => {
    const current = byId.get(node.id);
    if (!current) return;
    if (node.parentId && byId.has(node.parentId)) {
      byId.get(node.parentId)?.children.push(current);
    } else {
      roots.push(current);
    }
  });

  for (const item of byId.values()) {
    if (item.children.length > 0) {
      const slug = slugFromLabel(item.label);
      if (slug) {
        item.href = `/${slug}`;
      } else if (item.href === "#") {
        item.href = inferParentHrefFromChildren(item.children);
      }
    }
  }

  return roots;
}

const realMenu = buildHeaderMenuTree(items as FlatMenuNode[]);
const topBarHelpRoots = buildHeaderMenuTree(topBarFlat as FlatMenuNode[]);

const topMenuCallUs = [
  { label: "CALL US  805-981-0262", href: "tel:+18059810262" },
  { label: "Support", href: "#" },
];
const topMenuSocial = [
  {
    label: "Facebook",
    icon: "facebook" as const,
    href: "https://www.facebook.com/Waterway-Plastics-132649443445814/?ref=br_rs",
  },
  {
    label: "Instagram",
    icon: "instagram" as const,
    href: "https://www.instagram.com/waterwayplastics/",
  },
];

function topBarLinkAttrs(href: string): { target?: string; rel?: string } {
  if (/^https?:\/\//i.test(href)) {
    return { target: "_blank", rel: "noopener noreferrer" };
  }
  return {};
}

function menuItemHasNestedChildren(item: HeaderMenuNode): boolean {
  return item.children.some((c) => c.children.length > 0);
}

function splitMenuIntoColumns(
  links: MenuLink[],
  columnCount: number,
): MenuLink[][] {
  if (links.length === 0) return [];
  const per = Math.ceil(links.length / columnCount);
  const out: MenuLink[][] = [];
  for (let c = 0; c < columnCount; c++) {
    const slice = links.slice(c * per, (c + 1) * per);
    if (slice.length > 0) out.push(slice);
  }
  return out.length > 0 ? out : [links];
}

function normalizePathname(pathname: string): string {
  const p = (pathname || "/").trim();
  if (!p) return "/";
  const noQuery = p.split("?")[0] || "/";
  const noHash = noQuery.split("#")[0] || "/";
  const noTrail = noHash.replace(/\/+$/, "");
  return noTrail === "" ? "/" : noTrail;
}

function isMenuItemActive(href: string, pathname: string): boolean {
  const h = normalizePathname(href);
  const p = normalizePathname(pathname);
  const isRecallPath = p === "/resources/recall" || p.startsWith("/resources/recall/");
  const isHelpPath = p === "/help" || p.startsWith("/help/");
  const isProductInfoPath =
    p === "/product/information" || p.startsWith("/product/information/");
  const isCompanyMappedPath =
    p === "/about-us" ||
    p.startsWith("/about-us/") ||
    p === "/contact" ||
    p.startsWith("/contact/") ||
    p === "/news" ||
    p.startsWith("/news/") ||
    p === "/resources/employment-opportunities" ||
    p.startsWith("/resources/employment-opportunities/");
  const isForHomeownersMappedPath =
    p === "/distributor-locator" || p.startsWith("/distributor-locator/");
  const isSupportMappedPath = isRecallPath || isHelpPath || isProductInfoPath;
  if (!h || h === "#") return false;
  if (h === "/") return p === "/";
  if (
    h === "/products" &&
    !isProductInfoPath &&
    (p === "/product" || p.startsWith("/product/"))
  ) {
    return true;
  }
  if (h === "/support" && isSupportMappedPath) {
    return true;
  }
  if (h === "/company" && isCompanyMappedPath) {
    return true;
  }
  if (h === "/for-homeowners" && isForHomeownersMappedPath) {
    return true;
  }
  if (h === "/resources" && (isSupportMappedPath || isCompanyMappedPath)) return false;
  return p === h || p.startsWith(`${h}/`);
}
---

<header
  class:list={["header", ...(headerType === "white" ? ["header--white"] : [])]}
>
  <div class="header__top" data-header-top>
    <div class="header__top-container">
      <ul class="header__top-menu header__top-menu--call-us">
        {
          topMenuCallUs.map((item) => (
            <li class="header__top-item">
              <a
                class="header__top-link"
                href={item.href}
                aria-label={item.label}
                {...topBarLinkAttrs(item.href)}
              >
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="header__top-menu-right">
        <ul class="header__top-menu header__top-menu--help-us">
          {
            topBarHelpRoots.map((item) => (
              <li class="header__top-item">
                <a
                  class="header__top-link"
                  href={item.href}
                  aria-label={item.label}
                  {...topBarLinkAttrs(item.href)}
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="header__top-menu header__top-menu--social">
          {
            topMenuSocial.map((item) => (
              <li class="header__top-item">
                <a
                  class:list={[
                    "header__top-link",
                    `header__top-link--${item.label.toLowerCase()}`,
                  ]}
                  href={item.href}
                  aria-label={item.label}
                  {...topBarLinkAttrs(item.href)}
                >
                  <span class="visually-hidden">{item.label}</span>
                  {item.icon === "facebook" ? (
                    <IconFacebook />
                  ) : item.icon === "instagram" ? (
                    <IconInstagram />
                  ) : null}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <div class="header__container js-header-container">
    <div class="container">
      <div class="header__logo">
        <button
          type="button"
          class="header__burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="header-mobile"
          data-open-mobile
        >
          <span class="visually-hidden">Open menu</span>
          <IconBurger />
        </button>
        <a href="/" class="header__logo-link">
          <HeaderLogo class="header__logo-icon" />
        </a>
      </div>
      <nav class="header__nav" aria-label="Main">
        <ul class="header__menu">
          {
            realMenu.map((item) => {
              const hasSubmenu = item.children.length > 0;
              const isActive = isMenuItemActive(item.href, currentPathname);
              return (
                <li
                  class:list={[
                    "header__item",
                    hasSubmenu && "header__item--has-submenu",
                    isActive && "is-active",
                  ]}
                >
                  <a
                    class:list={[
                      "header__link",
                      hasSubmenu && "header__link--has-icon",
                      isActive && "is-active",
                    ]}
                    href={item.href}
                  >
                    {item.label}
                    {hasSubmenu && <IconArrowDown class="header__link-icon" />}
                  </a>
                  {hasSubmenu && (
                    <div class="header__submenu">
                      {menuItemHasNestedChildren(item) ? (
                        <div class="header__submenu-grid">
                          {item.children.map((col) => (
                            <ul
                              class="header__submenu-list"
                              role="list"
                              aria-label={col.label}
                            >
                              <li class="header__submenu-item">
                                <a class="header__submenu-link" href={col.href}>
                                  {col.label}
                                </a>
                              </li>
                              {col.children.map((sub) => (
                                <li class="header__submenu-item">
                                  <a
                                    class="header__submenu-link"
                                    href={sub.href}
                                  >
                                    {sub.label}
                                  </a>
                                </li>
                              ))}
                              <li class="header__submenu-item-link--find-more">
                                <a
                                  class="header__mobile-find-more"
                                  href={col.href}
                                >
                                  Find more
                                  <IconArrowRight />
                                </a>
                              </li>
                            </ul>
                          ))}
                        </div>
                      ) : (
                        <ul class="header__submenu-list" role="list">
                          {item.children.map((link) => (
                            <li class="header__submenu-item">
                              <a class="header__submenu-link" href={link.href}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div class="header__search" data-header-search>
        <button
          type="button"
          class="header__search-toggle"
          aria-expanded="false"
          aria-controls="header-search-panel"
          data-search-toggle
        >
          <span class="visually-hidden">Open search</span>
          <IconSearch class="header__search-toggle-icon" />
        </button>
        <div
          id="header-search-panel"
          class="header__search-panel"
          role="search"
        >
          <form action="/search" method="get">
            <div class="header__search-field">
              <label class="header__search-label">
                <IconSearch class="header__search-icon" />
                <input
                  class="header__search-input"
                  type="search"
                  name="q"
                  placeholder="Search for parts"
                  autocomplete="off"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="header-search-suggest"
                  data-header-search-input
                />
              </label>
              <div
                id="header-search-suggest"
                class="header__search-suggest"
                role="listbox"
                aria-label="Search suggestions"
                hidden
              >
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div
    class="header__mobile"
    id="header-mobile"
    role="dialog"
    aria-modal="true"
    aria-label="Main navigation"
    aria-hidden="true"
  >
    <div class="header__mobile-backdrop" tabindex="-1" data-close-mobile></div>
    <div class="header__mobile-sheet">
      <div class="header__mobile-sheet-inner">
        <div class="header__mobile-head">
          <button
            type="button"
            class="header__mobile-close"
            aria-label="Close menu"
            data-close-mobile
          >
            <IconClose />
          </button>
        </div>

        <div class="header__mobile-mega-narrow">
          {
            realMenu.map((item) => {
              if (item.children.length === 0) return null;
              return (
                <div class="header__mega-narrow-section">
                  <h2 class="header__mega-narrow-cat">
                    {item.label.toUpperCase()}
                  </h2>
                  <div class="header__mega-narrow-body">
                    {menuItemHasNestedChildren(item) ? (
                      <div class="header__mega-narrow-grid">
                        {item.children.map((col) => (
                          <div class="header__mega-narrow-column">
                            <p class="header__mega-narrow-col-title">
                              <a
                                class="header__mega-narrow-link"
                                href={col.href}
                              >
                                {col.label}
                              </a>
                            </p>
                            <ul
                              class="header__mega-narrow-col-list"
                              role="list"
                            >
                              {col.children.map((sub) => (
                                <li>
                                  <a
                                    class="header__mega-narrow-link"
                                    href={sub.href}
                                  >
                                    {sub.label}
                                  </a>
                                </li>
                              ))}
                              <li class="header__submenu-item-link--find-more">
                                <a
                                  class="header__mobile-find-more"
                                  href={col.href}
                                >
                                  Find more
                                  <IconArrowRight />
                                </a>
                              </li>
                            </ul>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="header__mega-narrow-flat">
                        {splitMenuIntoColumns(
                          item.children.map((c) => ({
                            label: c.label,
                            href: c.href,
                          })),
                          3,
                        ).map((col) => (
                          <ul class="header__mega-narrow-flat-col" role="list">
                            {col.map((link) => (
                              <li>
                                <a
                                  class="header__mega-narrow-link header__mega-narrow-link--flat"
                                  href={link.href}
                                >
                                  {link.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              );
            })
          }
        </div>

        <div class="header__mobile-stage">
          <div class="header__mobile-root" data-mobile-root>
            <ul class="header__mobile-list" role="list">
              {
                realMenu.map((item) => {
                  const hasSubmenu = item.children.length > 0;
                  const navKey = item.id;
                  return (
                    <li class="header__mobile-list-item">
                      {hasSubmenu ? (
                        <button
                          type="button"
                          class="header__mobile-row header__mobile-row--parent"
                          data-open-sub={navKey}
                          data-sub-label={item.label}
                        >
                          <span class="header__mobile-row-label">
                            {item.label}
                          </span>
                          <span
                            class="header__mobile-row-arrow"
                            aria-hidden="true"
                          >
                            <IconTailArrowRight />
                          </span>
                        </button>
                      ) : (
                        <a class="header__mobile-row" href={item.href}>
                          {item.label}
                        </a>
                      )}
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <div class="header__mobile-sub" data-mobile-sub hidden>
            <div class="header__mobile-sub-bar">
              <button
                type="button"
                class="header__mobile-back"
                data-mobile-back
              >
                <IconArrowRight class="header__mobile-back-icon" />
                <span>Back to menu</span>
              </button>
              <span class="header__mobile-sub-heading" data-mobile-sub-title>
              </span>
            </div>
            <div class="header__mobile-sub-panels">
              {
                realMenu.map((item) => {
                  if (item.children.length === 0) return null;
                  const navKey = item.id;
                  return (
                    <div
                      class="header__mobile-sub-panel"
                      data-mobile-sub-panel={navKey}
                      hidden
                    >
                      {menuItemHasNestedChildren(item) ? (
                        <div class="header__mobile-nested">
                          {item.children.map((col) => (
                            <div class="header__mobile-nested-group">
                              <a
                                class="header__mobile-nested-heading"
                                href={col.href}
                              >
                                {col.label}
                              </a>
                              <ul
                                class="header__mobile-nested-list"
                                role="list"
                              >
                                {col.children.map((sub) => (
                                  <li>
                                    <a
                                      class="header__mobile-flat-link"
                                      href={sub.href}
                                    >
                                      {sub.label}
                                    </a>
                                  </li>
                                ))}
                                <li class="header__submenu-item-link--find-more">
                                  <a
                                    class="header__mobile-find-more"
                                    href={col.href}
                                  >
                                    Find more
                                    <IconArrowRight />
                                  </a>
                                </li>
                              </ul>
                            </div>
                          ))}
                        </div>
                      ) : (
                        <ul class="header__mobile-flat" role="list">
                          {item.children.map((link) => (
                            <li>
                              <a
                                class="header__mobile-flat-link"
                                href={link.href}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import {
    initHeaderMobile,
    initHeaderSearch,
    initHeaderStickyScroll,
  } from "./header-mobile";
  initHeaderStickyScroll();
  initHeaderMobile();
  initHeaderSearch();
</script>
