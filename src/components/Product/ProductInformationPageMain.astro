---
import ProductPageBody from "./ProductPageBody.astro";
import Breadcrumbs from "../Breadcrumbs/Breadcrumbs.astro";
import Picture from "../Picture/Picture.astro";
import type { ProductPageData } from "../../lib/queries/product-detail";
import type { ProductPageView } from "../../lib/product-page-view";
import { pictureFromWpMediaNode } from "../../lib/picture-wp-media";

interface Props {
  graphqlConfigured: boolean;
  slug: string;
  product: ProductPageData["product"] | null;
  view: ProductPageView;
}

const { graphqlConfigured, slug, product, view } = Astro.props;
const { title, mainImg } = view;
const mainPicture = pictureFromWpMediaNode(mainImg, title || "Product image");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Support", href: "/support" },
  { label: title || "Information" },
];
---

<main class="product-page product-page--information" data-page-header-offset>
  <div class="product-page__content">
    <div class="product-page__hero">
      <h1 class="product-page__title">{title}</h1>
      {mainPicture ? (
        <div class="product-page__hero-main-image">
          <Picture
            alt={mainPicture.alt}
            sources={mainPicture.sources}
            img={{
              ...mainPicture.img,
              class: "product-page__main-product-image",
              loading: "eager",
              decoding: "async",
            }}
          />
        </div>
      ) : null}
    </div>
    <div class="product-page__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="product-page__inner product-page__wysiwyg">
      <ProductPageBody
        graphqlConfigured={graphqlConfigured}
        slug={slug}
        product={product}
        view={view}
      />
    </div>
  </div>
</main>
