---
import {
  normalizeProductListContent,
  parseSingleTemplateOptionalCharact,
  singleTemplateOptionalShowsGallery,
  wpPreferredThumbSrc,
  type SingleTemplateOptionalItem,
} from "../../lib/queries/product-detail";

interface Props {
  item: SingleTemplateOptionalItem;
  index: number;
}

const { item, index } = Astro.props;
const selectRaw = item.singleTemplateOptionalSelect;
const selectValues = (Array.isArray(selectRaw) ? selectRaw : [selectRaw])
  .filter((value): value is string => typeof value === "string")
  .map((value) =>
    value
      .trim()
      .toLowerCase()
      .replace(/[\s_-]+/g, ""),
  )
  .filter(Boolean);
const selectAttr = Array.isArray(selectRaw)
  ? selectRaw.filter(Boolean).join(",")
  : (selectRaw ?? "");

function hasSelect(...candidates: string[]): boolean {
  const candidateSet = candidates.map((v) =>
    v
      .trim()
      .toLowerCase()
      .replace(/[\s_-]+/g, ""),
  );
  return selectValues.some((value) => candidateSet.includes(value));
}

const showDescriptionHtml = hasSelect(
  "descriptionhtml",
  "deschtml",
  "description",
);
const showGallery = singleTemplateOptionalShowsGallery(item);
const showTable = hasSelect("table");
const showProductList = hasSelect("productlist", "productslist", "list");
const showFeatures = hasSelect("charact", "characteristics", "features");

const listRows = normalizeProductListContent(
  item.singleTemplateOptionalProductListContent,
);
const galleryNodes =
  item.singleTemplateOptionalGallery?.nodes?.filter((n) => n?.sourceUrl) ?? [];

const descHtml = item.singleTemplateOptionalDescHtml?.trim();
const descPlain = item.singleTemplateOptionalDesc?.trim();
const charactParsed = parseSingleTemplateOptionalCharact(
  item.singleTemplateOptionalCharact,
);
const charactHeading = charactParsed?.title?.replace(/\r\n/g, "\n").trim();
const charactBullets = charactParsed?.bullets ?? [];
const tableTitle = item.singleTemplateOptionalTableTitle?.trim();
const tableHtml = item.singleTemplateOptionalTable?.trim();
const plTitle = item.singleTemplateOptionalProductListTitle?.trim();
const plSubtitle = item.singleTemplateOptionalProductListSubtitle?.trim();
const plRowLabel = item.singleTemplateOptionalProductListRowLabel?.trim();

const hasDescriptionContent = Boolean(descHtml || descPlain);
const hasFeaturesContent = Boolean(charactParsed);
const hasGalleryContent = galleryNodes.length > 0;
const isGallerySlider = showGallery && galleryNodes.length > 1;
const isGalleryMini = showGallery && galleryNodes.length === 1;
const hasTableContent = Boolean(tableTitle || tableHtml);
const hasProductListContent = Boolean(
  plTitle || plSubtitle || plRowLabel || listRows.length > 0,
);

const hasAnything =
  (showDescriptionHtml && hasDescriptionContent) ||
  (showGallery && hasGalleryContent) ||
  (showTable && hasTableContent) ||
  (showProductList && hasProductListContent) ||
  (showFeatures && hasFeaturesContent);
---

{
  hasAnything && (
    <div
      class="product-page__optional-block"
      data-template-select={selectAttr}
      data-template-index={index}
    >
      {showDescriptionHtml && descHtml && (
        <div class="product-page__optional-html" set:html={descHtml} />
      )}
      {showDescriptionHtml && !descHtml && descPlain && (
        <p class="product-page__optional-text">{descPlain}</p>
      )}
      {showFeatures && hasFeaturesContent && charactParsed && (
        <>
          <h2 class="product-page__h2 product-page__h2--in-block">
            {charactHeading}
          </h2>
          {charactBullets.length > 0 && (
            <ul class="product-page__optional-charact-list">
              {charactBullets.map((text) => (
                <li>{text}</li>
              ))}
            </ul>
          )}
        </>
      )}
      {isGallerySlider && (
        <div
          class="product-page__gallery-section product-page__gallery-section--slider"
          data-product-gallery
          aria-label="Gallery"
        >
          <div class="product-page__gallery-frame product-page__gallery-frame--slider">
            <figure class="product-page__gallery-main-figure">
              <img
                class="product-page__gallery-main-img"
                src={galleryNodes[0]?.sourceUrl ?? ""}
                alt={galleryNodes[0]?.altText?.trim() ?? ""}
                loading="eager"
                decoding="async"
              />
              <figcaption
                class="product-page__image-caption"
                data-gallery-caption
                hidden={!Boolean(galleryNodes[0]?.title?.trim())}
              >
                {galleryNodes[0]?.title?.trim() ?? ""}
              </figcaption>
            </figure>
          </div>
          <div class="product-page__gallery-thumbs-row">
            <button
              type="button"
              class="product-page__gallery-arrow"
              data-gallery-prev
              aria-label="Previous image"
            >
              <span aria-hidden="true">‹</span>
            </button>
            <div class="product-page__gallery-thumbs">
              {galleryNodes.map((g, i) =>
                g?.sourceUrl ? (
                  <button
                    type="button"
                    class:list={[
                      "product-page__gallery-thumb",
                      i === 0 && "is-active",
                    ]}
                    data-full-src={g.sourceUrl}
                    data-full-alt={g.altText ?? ""}
                    data-full-title={g.title?.trim() ?? ""}
                    aria-label={`Image ${i + 1} of ${galleryNodes.length}`}
                    aria-pressed={i === 0}
                  >
                    <img
                      src={wpPreferredThumbSrc(g)}
                      alt=""
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </button>
                ) : null,
              )}
            </div>
            <button
              type="button"
              class="product-page__gallery-arrow"
              data-gallery-next
              aria-label="Next image"
            >
              <span aria-hidden="true">›</span>
            </button>
          </div>
          <div class="product-page__gallery-pagination" aria-live="polite">
            <button
              type="button"
              class="product-page__gallery-pagination-btn"
              data-gallery-prev
              aria-label="Previous image"
            >
              <span aria-hidden="true">‹</span>
            </button>
            <span class="product-page__gallery-pagination-text">
              <span data-gallery-current>1</span>
              <span class="product-page__gallery-pagination-sep"> / </span>
              <span data-gallery-total>{galleryNodes.length}</span>
            </span>
            <button
              type="button"
              class="product-page__gallery-pagination-btn"
              data-gallery-next
              aria-label="Next image"
            >
              <span aria-hidden="true">›</span>
            </button>
          </div>
        </div>
      )}
      {isGalleryMini && (
        <div class="product-page__gallery-mini">
          {galleryNodes.map((g) =>
            g?.sourceUrl ? (
              <figure class="product-page__gallery-mini-figure">
                <img
                  class="product-page__gallery-mini-img"
                  src={g.sourceUrl}
                  alt={g.altText?.trim() ?? ""}
                  loading="lazy"
                  decoding="async"
                />
                {g.title?.trim() && (
                  <figcaption class="product-page__image-caption">
                    {g.title.trim()}
                  </figcaption>
                )}
              </figure>
            ) : null,
          )}
        </div>
      )}
      {showTable && tableTitle && (
        <h2 class="product-page__h2 product-page__h2--in-block">
          {tableTitle}
        </h2>
      )}
      {showTable && tableHtml && (
        <div class="product-page__spec" set:html={tableHtml} />
      )}
      {showProductList && (plTitle || plSubtitle) && (
        <div class="product-page__product-list-head">
          {plTitle && (
            <h2 class="product-page__h2 product-page__h2--in-block">
              {plTitle}
            </h2>
          )}
          {plSubtitle && (
            <p class="product-page__optional-text">{plSubtitle}</p>
          )}
        </div>
      )}
      {showProductList && plRowLabel && (
        <p class="product-page__row-label">{plRowLabel}</p>
      )}
      {showProductList && listRows.length > 0 && (
        <ul class="product-page__product-list-rows">
          {listRows.map((row) => {
            const plNode = row.singleTemplateOptionalProductListItemImage?.node;
            return (
              <li class="product-page__product-list-row">
                {plNode?.sourceUrl && (
                  <figure class="product-page__product-list-figure">
                    <img
                      class="product-page__product-list-thumb"
                      src={wpPreferredThumbSrc(plNode)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    {plNode.title?.trim() && (
                      <figcaption class="product-page__image-caption">
                        {plNode.title.trim()}
                      </figcaption>
                    )}
                  </figure>
                )}
                {row.singleTemplateOptionalProductListItemTable?.trim() && (
                  <div
                    class="product-page__spec"
                    set:html={row.singleTemplateOptionalProductListItemTable}
                  />
                )}
              </li>
            );
          })}
        </ul>
      )}
    </div>
  )
}
