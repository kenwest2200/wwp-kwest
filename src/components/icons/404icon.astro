<style>
  .icon-404 {
    display: block;
    margin-inline: auto;
    overflow: visible;
    animation: icon404-float 4.5s ease-in-out infinite;
  }

  .icon-404__star {
    transform-box: fill-box;
    transform-origin: center;
    animation: icon404-twinkle 2.2s ease-in-out infinite;
  }

  .icon-404 > path.icon-404__star:nth-child(1) {
    animation-delay: 0s;
  }
  .icon-404 > path.icon-404__star:nth-child(2) {
    animation-delay: 0.35s;
  }
  .icon-404 > path.icon-404__star:nth-child(3) {
    animation-delay: 0.7s;
  }
  .icon-404 > path.icon-404__star:nth-child(4) {
    animation-delay: 1.05s;
  }

  .icon-404__dot {
    transform-box: fill-box;
    transform-origin: center;
    animation: icon404-dot 2.8s ease-in-out infinite;
  }

  .icon-404 > path.icon-404__dot:nth-child(5) {
    animation-delay: 0s;
  }
  .icon-404 > path.icon-404__dot:nth-child(6) {
    animation-delay: 0.2s;
  }
  .icon-404 > path.icon-404__dot:nth-child(7) {
    animation-delay: 0.4s;
  }
  .icon-404 > path.icon-404__dot:nth-child(8) {
    animation-delay: 0.6s;
  }
  .icon-404 > path.icon-404__dot:nth-child(9) {
    animation-delay: 0.8s;
  }
  .icon-404 > path.icon-404__dot:nth-child(10) {
    animation-delay: 1s;
  }
  .icon-404 > path.icon-404__dot:nth-child(11) {
    animation-delay: 1.2s;
  }
  .icon-404 > path.icon-404__dot:nth-child(12) {
    animation-delay: 1.4s;
  }
  .icon-404 > path.icon-404__dot:nth-child(13) {
    animation-delay: 1.6s;
  }

  .icon-404__digit {
    transform-box: fill-box;
    transform-origin: center;
    animation: icon404-digit 3.5s ease-in-out infinite;
  }

  .icon-404 > path.icon-404__digit:nth-child(14) {
    animation-delay: 0s;
  }
  .icon-404 > path.icon-404__digit:nth-child(15) {
    animation-delay: 0.25s;
  }

  .icon-404__glass {
    transform-origin: 48% 39%;
    transform-box: fill-box;
    animation: icon404-glass 5s ease-in-out infinite;
  }

  @keyframes icon404-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes icon404-twinkle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.9);
    }
  }

  @keyframes icon404-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
