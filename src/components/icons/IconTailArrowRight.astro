---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="14"
  height="10"
  viewBox="0 0 14 10"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <path
    d="M0.75 4.74979H12.75"
    stroke="#00AEC7"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M8.75 0.75L12.75 4.75L8.75 8.75"
    stroke="#00AEC7"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
