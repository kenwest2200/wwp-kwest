---
---

<section
  id="demo-filters-catalog"
  class="demo-filters-catalog"
  aria-label="Filters and product list"
>
  <div class="demo-filters-catalog__inner">
    <div class="demo-filters__layout">
      <section
        class="demo-filters__panel"
        aria-labelledby="demo-filters-heading"
      >
        <h2 id="demo-filters-heading" class="demo-filters__filters-title">Filters</h2>
        <p id="demo-filters-api-error" class="demo-filters__err" hidden></p>

        <div class="demo-filters__group demo-filters__group--search">
          <label class="demo-filters__search-label" for="demo-filters-search">
            Search products
          </label>
          <input
            id="demo-filters-search"
            type="search"
            class="demo-filters__search-input"
            placeholder="Title, slug, product type, category…"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Categories</h3>
          <div id="demo-filters-root" class="demo-filters__chips"></div>
        </div>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Product types</h3>
          <div id="demo-filters-sub" class="demo-filters__sub-panels"></div>
        </div>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Attributes</h3>
          <div id="demo-filters-attrs" class="demo-filters__attrs"></div>
        </div>

        <button type="button" id="demo-filters-clear" class="demo-filters__btn">
          Clear all
        </button>

        <p class="demo-filters__meta">
          <span id="demo-filters-count"></span>
        </p>
      </section>

      <section class="demo-filters__panel" aria-labelledby="demo-products-h">
        <h2 id="demo-products-h" class="demo-filters__h2">Products</h2>
        <div class="demo-filters__products-toolbar">
          <label class="demo-filters__toolbar-label">
            Per page
            <select
              id="demo-filters-per"
              class="demo-filters__toolbar-select"
              aria-label="Products per page"
            >
              <option value="12">12</option>
              <option value="24" selected>24</option>
              <option value="48">48</option>
            </select>
          </label>
          <label class="demo-filters__toolbar-label">
            Sort
            <select
              id="demo-filters-sort"
              class="demo-filters__toolbar-select"
              aria-label="Sort products"
            >
              <option value="newest" selected>Newest</option>
              <option value="oldest">Oldest</option>
              <option value="title">Title A–Z</option>
            </select>
          </label>
        </div>
        <p
          id="demo-filters-products-total"
          class="demo-filters__products-total"
        >
          Products found: 0
        </p>
        <ul id="demo-filters-products" class="demo-filters__list"></ul>
        <div class="demo-filters__pager">
          <button
            type="button"
            id="demo-filters-prev"
            class="demo-filters__btn"
          >
            Prev
          </button>
          <span id="demo-filters-page" class="demo-filters__page-indicator"
            >Page 1</span
          >
          <button
            type="button"
            id="demo-filters-next"
            class="demo-filters__btn"
          >
            Next
          </button>
        </div>
      </section>
    </div>
  </div>
</section>
