---
interface Props {
  title: string;
  intro?: string;
  introIsHtml?: boolean;
}

const { title, intro, introIsHtml = false } = Astro.props;
---

<section class="section-hero">
  <div class="container section-hero__container">
    <div class="section-hero__content">
      <h1 class="section-hero__title">{title}</h1>
      {
        intro &&
          (introIsHtml ? (
            <p class="section-hero__description" set:html={intro} />
          ) : (
            <p class="section-hero__description">{intro}</p>
          ))
      }
    </div>
  </div>
</section>
