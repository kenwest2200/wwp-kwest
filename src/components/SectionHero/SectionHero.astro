---
interface Props {
  title: string;
  titleIsHtml?: boolean;
  intro?: string;
  introIsHtml?: boolean;
  customClass?: string;
}

const {
  title,
  titleIsHtml = false,
  intro,
  introIsHtml = false,
  customClass = "",
} = Astro.props;
---

<section
  class={`section-hero ${customClass ? `section-hero--${customClass}` : ""}`}
>
  <div class="container section-hero__container">
    <div class="section-hero__content">
      {
        titleIsHtml ? (
          <h1 class="section-hero__title" set:html={title} />
        ) : (
          <h1 class="section-hero__title">{title}</h1>
        )
      }
      {
        intro &&
          (introIsHtml ? (
            <div class="section-hero__description" set:html={intro} />
          ) : (
            <p class="section-hero__description">{intro}</p>
          ))
      }
    </div>
  </div>
</section>
