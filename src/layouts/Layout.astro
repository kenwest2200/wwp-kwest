---
import "../styles/global.scss";
import { SEO } from "astro-seo";
import Header from "../components/Header/index.astro";
import Footer from "../components/Footer/index.astro";
import { getGraphQLClient, requestGraphql } from "../lib/graphql";
import {
  HEADER_LAYOUT_QUERY,
  type HeaderLayoutData,
} from "../lib/queries/layout-header";
import {
  FOOTER_LAYOUT_QUERY,
  type FooterLayoutData,
} from "../lib/queries/layout-footer";

export interface Props {
  headerType?: "white";
  /** e.g. `is-home` — body class for page-specific header styling */
  bodyClass?: string;
  pageTitle?: string;
  description?: string;
  robotsNoIndex?: boolean;
}

const { headerType, bodyClass, pageTitle, description, robotsNoIndex } =
  Astro.props;
const shortTitle = pageTitle?.trim() ?? "";
const hasPageTitle = shortTitle.length > 0;
const titleDefault = "Waterway Plastics - Pool & Spa Supplies";
const documentTitle = hasPageTitle
  ? `${shortTitle} | Waterway Plastics`
  : titleDefault;

const PUBLIC_SITE_URL = "https://waterwayplastics.com";
const siteOrigin = PUBLIC_SITE_URL.replace(/\/+$/, "") ?? "";
const originForAbsolute = siteOrigin.length > 0 ? siteOrigin : Astro.url.origin;
const canonicalHref = new URL(
  `${Astro.url.pathname}${Astro.url.search}`,
  `${originForAbsolute}/`,
).href;

const metaDescription =
  description?.trim() ||
  "Pool and spa supplies, parts, and equipment from Waterway Plastics.";
const ogImageUrl = `${originForAbsolute}/favicon.png`;

let headerData: HeaderLayoutData | null = null;
let footerData: FooterLayoutData | null = null;

if (getGraphQLClient()) {
  try {
    headerData = await requestGraphql<HeaderLayoutData>(HEADER_LAYOUT_QUERY);
  } catch {
    headerData = null;
  }
  try {
    footerData = await requestGraphql<FooterLayoutData>(FOOTER_LAYOUT_QUERY);
  } catch {
    footerData = null;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      charset="UTF-8"
      title={hasPageTitle ? shortTitle : undefined}
      titleTemplate={hasPageTitle ? "%s | Waterway Plastics" : undefined}
      titleDefault={titleDefault}
      description={metaDescription}
      canonical={canonicalHref}
      noindex={Boolean(robotsNoIndex)}
      nofollow={Boolean(robotsNoIndex)}
      openGraph={{
        basic: {
          title: documentTitle,
          type: "website",
          image: ogImageUrl,
          url: canonicalHref,
        },
        optional: {
          siteName: "Waterway Plastics",
          description: metaDescription,
          locale: "en_US",
        },
        image: {
          alt: "Waterway Plastics",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: documentTitle,
        description: metaDescription,
        image: ogImageUrl,
        imageAlt: "Waterway Plastics",
      }}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class:list={bodyClass ? [bodyClass] : []}>
    <Header data={headerData} headerType={headerType} />
    <slot />
    <Footer data={footerData} />
  </body>
</html>
