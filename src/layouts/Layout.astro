---
import "../styles/global.scss";
import Header from "../components/Header/index.astro";
import { getGraphQLClient, requestGraphql } from "../lib/graphql";
import {
  HEADER_LAYOUT_QUERY,
  type HeaderLayoutData,
} from "../lib/queries/layout-header";

let headerData: HeaderLayoutData | null = null;

if (getGraphQLClient()) {
  try {
    headerData = await requestGraphql<HeaderLayoutData>(HEADER_LAYOUT_QUERY);
  } catch {
    headerData = null;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Waterway Plastics - Pool & Spa Supplies</title>
  </head>
  <body>
    <Header data={headerData} />
    <slot />
  </body>
</html>
