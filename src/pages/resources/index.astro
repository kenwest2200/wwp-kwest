---
import Layout from "../../layouts/Layout.astro";
import PageHeaderOffset from "../../components/PageHeaderOffset.astro";
import SectionHero from "../../components/SectionHero/SectionHero.astro";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";
import IconArrowRight from "../../components/icons/IconArrowRight.astro";
import { requestGraphql } from "../../lib/graphql";
import {
  TECHNICAL_BULLETINS_PAGE_QUERY,
  normalizeTechnicalBulletinsCards,
  type TechnicalBulletinsPageData,
} from "../../lib/queries/resources-technical-bulletins-page";

export const prerender = true;

const RESOURCES_PARENT_URI = "/resources/";
const introDefault =
  "Access technical guides, catalogs, tools, and videos to help you design, install, and maintain your pool and spa systems with confidence.";

async function loadPage(): Promise<TechnicalBulletinsPageData["page"] | null> {
  const uris = [RESOURCES_PARENT_URI, RESOURCES_PARENT_URI.replace(/\/$/, "")];
  for (const id of uris) {
    try {
      const data = await requestGraphql<TechnicalBulletinsPageData>(
        TECHNICAL_BULLETINS_PAGE_QUERY,
        { id },
      );
      if (data.page?.title) return data.page;
    } catch {
      /* try next */
    }
  }
  return null;
}

const pageNode = await loadPage();
const pageTitle = pageNode?.title?.trim() || "Resources";
const cards = normalizeTechnicalBulletinsCards(pageNode);
const breadcrumbs = [{ label: "Home", href: "/" }, { label: pageTitle }];
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main class="resources-index" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} />
    <div class="resources-index__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="resources-index__main">
      {
        cards.length > 0 && (
          <div class="resources-index__grid">
            {cards.map((card) => (
              <a
                class="resources-index__card"
                href={card.linkUrl}
                target={card.linkTarget}
                rel={
                  card.linkTarget === "_blank"
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                {card.iconUrl ? (
                  <div class="resources-index__card-icon-wrap">
                    <img
                      class="resources-index__card-icon"
                      src={card.iconUrl}
                      alt={card.iconAlt}
                      width={card.iconWidth}
                      height={card.iconHeight}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : null}
                <h2 class="resources-index__card-title">{card.title}</h2>
                {card.descriptionHtml ? (
                  <div
                    class="resources-index__card-desc"
                    set:html={card.descriptionHtml}
                  />
                ) : null}
                <span class="resources-index__card-action">
                  {card.linkLabel || "View guide"}
                  <IconArrowRight />
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </main>
</Layout>

<PageHeaderOffset />
