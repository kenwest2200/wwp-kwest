---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";
import { getGraphQLClient, requestGraphql } from "../../../lib/graphql";
import IconApple from "../../../assets/images/buttonAppStore.png";
import IconGooglePlay from "../../../assets/images/buttonGooglePlay.png";
import {
  APPS_TOOLS_PAGE_QUERY,
  APPS_TOOLS_PAGE_URI,
  normalizeAppsToolsPage,
  type AppsToolsPageData,
} from "../../../lib/queries/resources-apps-tools-page";

export const prerender = true;

const graphqlConfigured = Boolean(getGraphQLClient());

const introDefault =
  "Explore Waterway mobile apps and practical digital tools for setup, calculations, and product support.";

async function loadPage(): Promise<AppsToolsPageData["page"] | null> {
  if (!graphqlConfigured) return null;
  const uris = [APPS_TOOLS_PAGE_URI, APPS_TOOLS_PAGE_URI.replace(/\/$/, "")];
  for (const id of uris) {
    try {
      const data = await requestGraphql<AppsToolsPageData>(
        APPS_TOOLS_PAGE_QUERY,
        {
          id,
        },
      );
      if (data.page?.title) return data.page;
    } catch {
      /* try next */
    }
  }
  return null;
}

const pageNode = await loadPage();
const pageTitle = pageNode?.title?.trim() || "Apps & tools";
const pageData = normalizeAppsToolsPage(pageNode);
const hasContent = pageData.apps.length > 0 || pageData.tools.length > 0;
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main class="apps-tools-page" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} />

    <div class="apps-tools-page__body">
      <div class="apps-tools-page__body-inner">
        {
          !graphqlConfigured && (
            <p class="apps-tools-page__notice">
              GraphQL is not configured. Set <code>PUBLIC_GRAPHQL_URL</code> in{" "}
              <code>.env</code> to load this page.
            </p>
          )
        }
        {
          graphqlConfigured && !hasContent && (
            <p class="apps-tools-page__notice">
              No content was returned for <code>{APPS_TOOLS_PAGE_URI}</code>.
              Check ACF field <code>appsToolsSettings</code> and WPGraphQL
              schema.
            </p>
          )
        }

        {
          pageData.apps.length > 0 && (
            <div
              class="apps-tools-page__group"
              aria-labelledby="apps-tools-apps"
            >
              <h2 id="apps-tools-apps" class="apps-tools-page__group-title">
                {pageData.appsGroupTitle || "Apps"}
              </h2>
              <div class="apps-tools-page__apps-grid">
                {pageData.apps.map((app) => (
                  <article class="apps-tools-page__app-card">
                    {app.imageUrl ? (
                      <div class="apps-tools-page__app-image-wrap">
                        <img
                          class="apps-tools-page__app-image"
                          src={app.imageUrl}
                          alt={app.imageAlt}
                          width={app.imageWidth}
                          height={app.imageHeight}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : null}
                    <h3 class="apps-tools-page__app-title">{app.title}</h3>
                    <div class="apps-tools-page__store-links">
                      {app.appStoreLink ? (
                        <a
                          class="apps-tools-page__store-link apps-tools-page__store-link--app-store"
                          href={app.appStoreLink}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <img src={IconApple.src} alt="App Store" />
                          <span class="visually-hidden">App Store</span>
                        </a>
                      ) : null}
                      {app.googlePlayLink ? (
                        <a
                          class="apps-tools-page__store-link apps-tools-page__store-link--google-play"
                          href={app.googlePlayLink}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <img src={IconGooglePlay.src} alt="Google Play" />
                          <span class="visually-hidden">Google Play</span>
                        </a>
                      ) : null}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )
        }

        {
          pageData.tools.length > 0 && (
            <div
              class="apps-tools-page__group"
              aria-labelledby="apps-tools-tools"
            >
              <h2 id="apps-tools-tools" class="apps-tools-page__group-title">
                {pageData.toolsGroupTitle || "Tools"}
              </h2>
              <div class="apps-tools-page__tools-grid">
                {pageData.tools.map((tool) => (
                  <a
                    class="apps-tools-page__tool-card"
                    href={tool.linkUrl}
                    target={tool.linkTarget}
                    rel={
                      tool.linkTarget === "_blank"
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {tool.imageUrl ? (
                      <div class="apps-tools-page__tool-image-wrap">
                        <img
                          class="apps-tools-page__tool-image"
                          src={tool.imageUrl}
                          alt={tool.imageAlt}
                          width={tool.imageWidth}
                          height={tool.imageHeight}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : null}
                    <div class="apps-tools-page__tool-content">
                      <h3 class="apps-tools-page__tool-title">{tool.title}</h3>
                      {tool.descriptionHtml ? (
                        <div
                          class="apps-tools-page__tool-desc"
                          set:html={tool.descriptionHtml}
                        />
                      ) : null}
                      <span class="btn btn--primary-dark apps-tools-page__tool-action">
                        {tool.linkLabel}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />
