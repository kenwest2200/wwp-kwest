---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";
import Breadcrumbs from "../../../components/Breadcrumbs/Breadcrumbs.astro";
import Picture from "../../../components/Picture/Picture.astro";
import IconArrowRight from "../../../components/icons/IconArrowRight.astro";
import { getGraphQLClient, requestGraphql } from "../../../lib/graphql";
import { pictureFromWpMediaNode } from "../../../lib/picture-wp-media";
import {
  INSTRUCTIONAL_VIDEOS_PAGE_QUERY,
  INSTRUCTIONAL_VIDEOS_PAGE_URI,
  normalizeInstructionalVideos,
  type InstructionalVideosPageData,
} from "../../../lib/queries/instructional-videos-page";

export const prerender = true;

const graphqlConfigured = Boolean(getGraphQLClient());

const introDefault = `Browse step-by-step instructional videos for Waterway products. <br /> Learn how to install, maintain, and troubleshoot components with clear, practical guidance.`;

async function loadPage(): Promise<InstructionalVideosPageData["page"] | null> {
  if (!graphqlConfigured) return null;
  const uris = [
    INSTRUCTIONAL_VIDEOS_PAGE_URI,
    INSTRUCTIONAL_VIDEOS_PAGE_URI.replace(/\/$/, ""),
  ];
  for (const id of uris) {
    try {
      const data = await requestGraphql<InstructionalVideosPageData>(
        INSTRUCTIONAL_VIDEOS_PAGE_QUERY,
        { id },
      );
      if (data.page?.title) return data.page;
    } catch {
      /* try next */
    }
  }
  return null;
}

const pageNode = await loadPage();
const pageTitle = pageNode?.title?.trim() || "Instructional videos";
const videosRaw = normalizeInstructionalVideos(
  pageNode?.instructionalVideos ?? null,
);
const videos = videosRaw.map((v) => ({
  ...v,
  picture: pictureFromWpMediaNode(
    v.imageNode,
    v.imageAlt || v.title || "Video",
  ),
}));
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Resources", href: "/resources" },
  { label: pageTitle },
];
---

<Layout headerType="white">
  <main class="iv-page" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} introIsHtml />

    <div class="iv-page__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="iv-page__body">
      <div class="iv-page__body-inner">
        {
          videos.length === 0 ? (
            <p class="iv-page__empty">
              {graphqlConfigured
                ? "No videos are configured for this page yet."
                : "GraphQL is not configured."}
            </p>
          ) : (
            <div class="iv-page__grid">
              {videos.map((v, idx) => {
                const playClipId = `iv-play-clip-${idx}`;
                return (
                  <a
                    class="iv-page__card"
                    href={v.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={v.textOnHover || v.title}
                  >
                    <div class="iv-page__card-media">
                      {v.picture ? (
                        <Picture
                          alt={v.picture.alt}
                          sources={v.picture.sources}
                          img={{
                            ...v.picture.img,
                            class: "iv-page__card-img",
                            loading: "lazy",
                            decoding: "async",
                          }}
                        />
                      ) : (
                        <div class="iv-page__card-img" aria-hidden="true" />
                      )}
                      <div
                        class="iv-page__card-media-overlay"
                        aria-hidden="true"
                      >
                        <span class="iv-page__card-play">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="60"
                            height="60"
                            viewBox="0 0 60 60"
                            fill="none"
                            aria-hidden="true"
                          >
                            <g clip-path={`url(#${playClipId})`}>
                              <circle cx="30" cy="30" r="30" fill="#00AEC7" />
                              <path
                                d="M36.5 30L27.5 35.5V24.5L36.5 30Z"
                                fill="white"
                              />
                            </g>
                            <defs>
                              <clipPath id={playClipId}>
                                <rect width="60" height="60" fill="white" />
                              </clipPath>
                            </defs>
                          </svg>
                        </span>
                      </div>
                    </div>
                    <div class="iv-page__card-body">
                      <h2 class="iv-page__card-title">{v.title}</h2>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        }

        <a
          href="https://www.youtube.com/@waterwayplastics8666/"
          class="iv-page__view-all btn btn--primary-dark"
          target="_blank"
          rel="noopener noreferrer">Watch on YouTube <IconArrowRight /></a
        >
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />
