---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";
import IconArrowRight from "../../../components/icons/IconArrowRight.astro";
import { getGraphQLClient, requestGraphql } from "../../../lib/graphql";
import {
  TECHNICAL_BULLETINS_PAGE_QUERY,
  TECHNICAL_BULLETINS_PAGE_URI,
  normalizeTechnicalBulletinsCards,
  type TechnicalBulletinsPageData,
} from "../../../lib/queries/resources-technical-bulletins-page";

export const prerender = true;

const graphqlConfigured = Boolean(getGraphQLClient());

const introDefault =
  "Use practical tools and reference guides to calculate flow, size equipment, and design efficient pool and spa systems.";

async function loadPage(): Promise<TechnicalBulletinsPageData["page"] | null> {
  if (!graphqlConfigured) return null;
  const uris = [
    TECHNICAL_BULLETINS_PAGE_URI,
    TECHNICAL_BULLETINS_PAGE_URI.replace(/\/$/, ""),
  ];
  for (const id of uris) {
    try {
      const data = await requestGraphql<TechnicalBulletinsPageData>(
        TECHNICAL_BULLETINS_PAGE_QUERY,
        { id },
      );
      if (data.page?.title) return data.page;
    } catch {
      /* try next */
    }
  }
  return null;
}

const pageNode = await loadPage();
const pageTitle = pageNode?.title?.trim() || "Technical guide";
const cards = normalizeTechnicalBulletinsCards(pageNode);
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main class="tb-page" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} />

    <div class="tb-page__body">
      <div class="tb-page__body-inner">
        {
          !graphqlConfigured && (
            <p class="tb-page__notice">
              GraphQL is not configured. Set <code>PUBLIC_GRAPHQL_URL</code> in{" "}
              <code>.env</code> to load this page.
            </p>
          )
        }
        {
          graphqlConfigured && cards.length === 0 && (
            <p class="tb-page__notice">
              No cards were returned for{" "}
              <code>{TECHNICAL_BULLETINS_PAGE_URI}</code>. Check ACF field{" "}
              <code>cardsSettings</code> and WPGraphQL schema.
            </p>
          )
        }
        {
          cards.length > 0 && (
            <div class="tb-page__grid">
              {cards.map((card) => (
                <a
                  class="tb-page__card"
                  href={card.linkUrl}
                  target={card.linkTarget}
                  rel={
                    card.linkTarget === "_blank"
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {card.iconUrl ? (
                    <div class="tb-page__card-icon-wrap">
                      <img
                        class="tb-page__card-icon"
                        src={card.iconUrl}
                        alt={card.iconAlt}
                        width={card.iconWidth}
                        height={card.iconHeight}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : null}
                  <h2 class="tb-page__card-title">{card.title}</h2>
                  {card.descriptionHtml ? (
                    <div
                      class="tb-page__card-desc"
                      set:html={card.descriptionHtml}
                    />
                  ) : null}
                  <span class="tb-page__card-action">
                    {card.linkLabel}
                    <IconArrowRight />
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />
