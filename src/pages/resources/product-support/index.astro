---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";
import { getGraphQLClient, requestGraphql } from "../../../lib/graphql";
import {
  RESOURCES_SINGLE_LAYOUT_PAGE_QUERY,
  normalizeResourceSingleLayouts,
  sidebarDescriptionHtml,
  type ResourcesSingleLayoutPageData,
} from "../../../lib/queries/resources-single-layout-page";

export const prerender = true;

/** WordPress URI for this route (with or without trailing slash in fetch). */
export const PRODUCT_SUPPORT_PAGE_URI = "/resources/product-support/";

const graphqlConfigured = Boolean(getGraphQLClient());

const introDefault =
  "Product support resources, manuals, and reference information from Waterway Plastics.";

async function loadPage(): Promise<
  ResourcesSingleLayoutPageData["page"] | null
> {
  if (!graphqlConfigured) return null;
  const uris = [
    PRODUCT_SUPPORT_PAGE_URI,
    PRODUCT_SUPPORT_PAGE_URI.replace(/\/$/, ""),
  ];
  for (const id of uris) {
    try {
      const data = await requestGraphql<ResourcesSingleLayoutPageData>(
        RESOURCES_SINGLE_LAYOUT_PAGE_QUERY,
        { id },
      );
      if (data.page?.title) return data.page;
    } catch {
      /* try next */
    }
  }
  return null;
}

const pageNode = await loadPage();
const pageTitle = pageNode?.title?.trim() || "Product support";
const sidebarHtml = sidebarDescriptionHtml(pageNode?.resources ?? null);
const items = normalizeResourceSingleLayouts(pageNode?.resources ?? null);
const hasSidebar = sidebarHtml.length > 0;
const hasList = items.length > 0;
const hasContent = hasSidebar || hasList;
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main class="rsl-page" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} />

    <div class="rsl-page__body">
      <div class="rsl-page__body-inner">
        {
          !graphqlConfigured && (
            <p class="rsl-page__notice">
              GraphQL is not configured. Set <code>PUBLIC_GRAPHQL_URL</code> in{" "}
              <code>.env</code> to load this page.
            </p>
          )
        }
        {
          graphqlConfigured && !hasContent && (
            <p class="rsl-page__notice">
              No resources were returned for{" "}
              <code>{PRODUCT_SUPPORT_PAGE_URI}</code>. Check the page in
              WordPress and ACF / GraphQL field names.
            </p>
          )
        }
        {
          hasContent && (
            <div
              class:list={[
                "rsl-page__layout",
                !hasSidebar && "rsl-page__layout--main-only",
              ]}
            >
              {hasSidebar && (
                <aside class="rsl-page__sidebar" aria-label="Section overview">
                  <div
                    class="rsl-page__sidebar-html product-page__optional-html"
                    set:html={sidebarHtml}
                  />
                </aside>
              )}
              <div class="rsl-page__main">
                {hasList ? (
                  <ul class="rsl-page__list">
                    {items.map((it) => (
                      <li class="rsl-page__item">
                        <article class="rsl-page__article">
                          <h2 class="rsl-page__item-title">{it.name}</h2>
                          {it.characteristicsHtml ? (
                            <div
                              class="rsl-page__item-body product-page__optional-html"
                              set:html={it.characteristicsHtml}
                            />
                          ) : (
                            <p class="rsl-page__item-empty">No details.</p>
                          )}
                        </article>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="rsl-page__empty-main">
                    No resource entries in this section yet.
                  </p>
                )}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />
