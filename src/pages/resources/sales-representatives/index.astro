---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";

export const prerender = true;

const pageTitle = "Sales representatives";
const heroTitle = "Find your sales representative by ZIP code";
const heroIntro =
  "Enter your U.S. ZIP code to see the sales representatives assigned to your territory.";
---

<Layout headerType="white" pageTitle={pageTitle} description={heroIntro}>
  <main class="sr-page" data-page-header-offset data-sales-reps-page>
    <SectionHero title={heroTitle} intro={heroIntro} />

    <div class="sr-page__body">
      <div class="sr-page__body-inner">
        <form
          class="sr-page__search"
          id="sr-search-form"
          autocomplete="postal-code"
          aria-label="Search sales representatives by ZIP code"
        >
          <div class="sr-page__search-row">
            <div class="sr-page__search-field">
              <label class="sr-page__label" for="sr-zip-input"
                >Search Sale Reps by address / ZIP / city</label
              >
              <div class="sr-page__input-wrap">
                <span class="sr-page__input-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M21 21l-4.3-4.3"></path>
                  </svg>
                </span>
                <input
                  id="sr-zip-input"
                  name="zip"
                  type="text"
                  class="sr-page__input"
                  inputmode="numeric"
                  maxlength="10"
                  placeholder="e.g. 33304"
                  aria-describedby="sr-zip-hint"
                  autocomplete="postal-code"
                />
                <button
                  type="submit"
                  class="btn btn--primary-dark sr-page__submit"
                >
                  Search
                </button>
              </div>
            </div>
          </div>
        </form>

        <p id="sr-message" class="sr-page__message" hidden role="alert"></p>

        <section class="sr-page__results" aria-labelledby="sr-results-heading">
          <h2 id="sr-results-heading" class="sr-page__results-title">
            Sales representatives
          </h2>
          <div class="sr-page__table-wrap">
            <table class="sr-page__table">
              <thead>
                <tr>
                  <th
                    scope="col"
                    class="sr-page__th sr-page__th--sortable"
                    id="sr-th-name"
                    aria-sort="none"
                  >
                    Name
                    <span
                      class="sr-page__sort-btns"
                      role="group"
                      aria-label="Sort by: Name"
                    >
                      <button
                        type="button"
                        class="sr-page__sort-btn sr-page__sort-btn--asc"
                        id="sr-sort-name-asc"
                        aria-label="Sort by ascending: Name"
                        title="Sort by ascending"
                      >
                        <svg
                          class="sr-page__sort-svg"
                          width="12"
                          height="8"
                          viewBox="0 0 12 8"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            class="sr-page__sort-path"
                            d="M1.5 6.5L6 2L10.5 6.5"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="sr-page__sort-btn sr-page__sort-btn--desc"
                        id="sr-sort-name-desc"
                        aria-label="Sort by descending: Name"
                        title="Sort by descending"
                      >
                        <svg
                          class="sr-page__sort-svg"
                          width="12"
                          height="8"
                          viewBox="0 0 12 8"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            class="sr-page__sort-path"
                            d="M1.5 2L6 6.5L10.5 2"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </button>
                    </span>
                  </th>
                  <th scope="col" class="sr-page__th">Phone number</th>
                  <th scope="col" class="sr-page__th">Email</th>
                </tr>
              </thead>
              <tbody id="sr-table-body"></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />

<script>
  import { initSalesRepresentativesPage } from "../../../scripts/sales-representatives-page.ts";
  initSalesRepresentativesPage();
</script>
