---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";

export const prerender = true;

const pageTitle = "Sales representatives";
const heroTitle = "Find your sales representative by ZIP code";
const heroIntro =
  "Enter your U.S. ZIP code to see the sales representatives assigned to your territory.";
---

<Layout headerType="white" pageTitle={pageTitle} description={heroIntro}>
  <main class="sr-page" data-page-header-offset data-sales-reps-page>
    <SectionHero title={heroTitle} intro={heroIntro} />

    <div class="sr-page__body">
      <div class="sr-page__body-inner">
        <form
          class="sr-page__search"
          id="sr-search-form"
          autocomplete="postal-code"
          aria-label="Search sales representatives by ZIP code"
        >
          <div class="sr-page__search-row">
            <div class="sr-page__search-field">
              <label class="sr-page__label" for="sr-zip-input"
                >Search Sale Reps by address / ZIP / city</label
              >
              <div class="sr-page__input-wrap">
                <span class="sr-page__input-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M21 21l-4.3-4.3"></path>
                  </svg>
                </span>
                <input
                  id="sr-zip-input"
                  name="zip"
                  type="text"
                  class="sr-page__input"
                  inputmode="numeric"
                  maxlength="10"
                  placeholder="e.g. 33304"
                  aria-describedby="sr-zip-hint"
                  autocomplete="postal-code"
                />
              </div>
              <p id="sr-zip-hint" class="sr-page__hint">
                U.S. ZIP only — 5 digits or ZIP+4 (e.g. 33304 or 33304-1234).
              </p>
            </div>
            <button type="submit" class="btn btn--primary-dark sr-page__submit">
              Search
            </button>
          </div>
        </form>

        <p id="sr-message" class="sr-page__message" hidden role="alert"></p>

        <section class="sr-page__results" aria-labelledby="sr-results-heading">
          <h2 id="sr-results-heading" class="sr-page__results-title">
            Sales representatives
          </h2>
          <div class="sr-page__table-wrap">
            <table class="sr-page__table">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Phone number</th>
                  <th scope="col">Email</th>
                </tr>
              </thead>
              <tbody id="sr-table-body"></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />

<script>
  import { initSalesRepresentativesPage } from "../../../scripts/sales-representatives-page.ts";
  initSalesRepresentativesPage();
</script>
