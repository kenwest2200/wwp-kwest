---
import Layout from "../../../layouts/Layout.astro";
import PageHeaderOffset from "../../../components/PageHeaderOffset.astro";
import SectionHero from "../../../components/SectionHero/SectionHero.astro";
import Breadcrumbs from "../../../components/Breadcrumbs/Breadcrumbs.astro";
import PageErrorToast from "../../../components/PageErrorToast.astro";

export const prerender = true;

const pageTitle = "Sales representatives";
const heroTitle = "Find Sales Representatives";
const breadcrumbCurrentLabel = heroTitle;
const heroIntro =
  "Waterway sales representatives are available across multiple regions.  Use the map below to find your local contact for product information and support.";
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Support", href: "/support" },
  { label: "Help", href: "/help" },
  { label: breadcrumbCurrentLabel },
];
---

<Layout headerType="white" pageTitle={pageTitle} description={heroIntro}>
  <main class="sr-page" data-page-header-offset data-sales-reps-page>
    <SectionHero title={heroTitle} intro={heroIntro} />
    <div class="sr-page__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="sr-page__body">
      <div class="sr-page__body-inner">
        <form
          class="sr-page__search"
          id="sr-search-form"
          autocomplete="postal-code"
          aria-label="Search sales representatives by ZIP code"
        >
          <div class="sr-page__search-row">
            <div class="sr-page__search-field">
              <label class="sr-page__label" for="sr-zip-input"
                >Search Sale Reps by ZIP</label
              >
              <div class="sr-page__input-wrap">
                <button
                  type="submit"
                  class="dl-page__locator-search-icon-btn"
                  aria-label="Search"
                  data-sr-search-submit
                >
                  <span
                    class="dl-page__locator-search-icon-btn-inner"
                    aria-hidden="true"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="M21 21l-4.3-4.3"></path>
                    </svg>
                  </span>
                </button>
                <input
                  id="sr-zip-input"
                  name="zip"
                  type="text"
                  class="sr-page__input"
                  maxlength="10"
                  placeholder="e.g. 33304"
                  aria-describedby="sr-zip-hint sr-search-inline-error"
                  autocomplete="postal-code"
                />
                <button
                  type="button"
                  class="dl-page__locator-geolocate"
                  aria-label="Use your current location"
                  data-sr-geolocate
                >
                  <span class="dl-page__locator-geolocate-tooltip"
                    >Use your current location</span
                  >
                  <span
                    class="dl-page__locator-geolocate-icon"
                    aria-hidden="true"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <path
                        d="M2 12H5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <path
                        d="M19 12H22"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <path
                        d="M12 2V5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <path
                        d="M12 19V22"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <path
                        d="M12 19C15.866 19 19 15.866 19 12C19 8.13401 15.866 5 12 5C8.13401 5 5 8.13401 5 12C5 15.866 8.13401 19 12 19Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </button>
              </div>
              <p
                id="sr-search-inline-error"
                class="sr-page__search-inline-error"
                hidden
                role="alert"
              >
              </p>
            </div>
          </div>
        </form>

        <PageErrorToast id="sr-message" />

        <section
          id="sr-results"
          class="sr-page__results"
          aria-labelledby="sr-results-heading"
          hidden
        >
          <h2 id="sr-results-heading" class="sr-page__results-title">
            Sales representatives
          </h2>
          <div id="sr-results-loader" class="sr-page__results-loader" hidden>
            <span class="sr-page__results-loader-spinner" aria-hidden="true"
            ></span>
            <span class="sr-page__results-loader-text">Loading...</span>
          </div>
          <div id="sr-table-wrap" class="sr-page__table-wrap">
            <table class="sr-page__table">
              <thead>
                <tr>
                  <th
                    scope="col"
                    class="sr-page__th sr-page__th--sortable"
                    id="sr-th-name"
                    aria-sort="none"
                  >
                    Name
                    <span
                      class="sr-page__sort-btns"
                      role="group"
                      aria-label="Sort by: Name"
                    >
                      <button
                        type="button"
                        class="sr-page__sort-btn sr-page__sort-btn--asc"
                        id="sr-sort-name-asc"
                        aria-label="Sort by ascending: Name"
                        title="Sort by ascending"
                      >
                        <svg
                          class="sr-page__sort-svg"
                          width="12"
                          height="8"
                          viewBox="0 0 12 8"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            class="sr-page__sort-path"
                            d="M1.5 6.5L6 2L10.5 6.5"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="sr-page__sort-btn sr-page__sort-btn--desc"
                        id="sr-sort-name-desc"
                        aria-label="Sort by descending: Name"
                        title="Sort by descending"
                      >
                        <svg
                          class="sr-page__sort-svg"
                          width="12"
                          height="8"
                          viewBox="0 0 12 8"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            class="sr-page__sort-path"
                            d="M1.5 2L6 6.5L10.5 2"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </button>
                    </span>
                  </th>
                  <th scope="col" class="sr-page__th">Phone number</th>
                  <th scope="col" class="sr-page__th">Email</th>
                </tr>
              </thead>
              <tbody id="sr-table-body"></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />

<script>
  import { initSalesRepresentativesPage } from "../../../scripts/sales-representatives-page.ts";
  initSalesRepresentativesPage();
</script>
