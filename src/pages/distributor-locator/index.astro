---
import Layout from "../../layouts/Layout.astro";
import PageHeaderOffset from "../../components/PageHeaderOffset.astro";
import SectionHero from "../../components/SectionHero/SectionHero.astro";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";
import PageErrorToast from "../../components/PageErrorToast.astro";

export const prerender = true;

const mapsBrowserKey =
  import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY?.trim() ?? "";

const pageTitle = "Dealer Locator";
const introDefault =
  "Looking for Waterway products? Find an authorized distributor near you using the search below.";
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "For homeowners", href: "/for-homeowners" },
  { label: pageTitle },
];
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main
    class="dl-page"
    data-page-header-offset
    data-dl-locator
    data-dl-maps-key={mapsBrowserKey}
  >
    <SectionHero title={pageTitle} intro={introDefault} />
    <div class="dl-page__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="dl-page__body">
      <div class="dl-page__body-inner">
        <section
          class="dl-page__locator"
          aria-labelledby="dl-locator-heading"
          data-dl-tool
        >
          <form
            class="dl-page__locator-form"
            id="dl-locator-form"
            autocomplete="postal-code"
            aria-label="Search distributors by ZIP code"
          >
            <div class="dl-page__locator-search-block">
              <label class="dl-page__locator-label" for="dl-zip-input"
                >Search by ZIP
              </label>
              <div class="dl-page__locator-search-row">
                <div class="dl-page__locator-input-wrap">
                  <button
                    type="button"
                    class="dl-page__locator-search-icon-btn"
                    aria-label="Search"
                    data-dl-search-submit
                  >
                    <span
                      class="dl-page__locator-search-icon-btn-inner"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M21 21l-4.3-4.3"></path>
                      </svg>
                    </span>
                  </button>
                  <input
                    id="dl-zip-input"
                    name="zip"
                    type="text"
                    class="dl-page__locator-input"
                    maxlength="200"
                    placeholder="ZIP"
                    aria-describedby="dl-search-inline-error"
                    autocomplete="postal-code"
                    enterkeyhint="search"
                  />
                  <button
                    type="button"
                    class="dl-page__locator-geolocate"
                    id="dl-geolocate-btn"
                    aria-label="Use your current location"
                    data-dl-geolocate
                  >
                    <span class="dl-page__locator-geolocate-tooltip"
                      >Use your current location</span
                    >
                    <span
                      class="dl-page__locator-geolocate-icon"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <path
                          d="M2 12H5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                        <path
                          d="M19 12H22"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                        <path
                          d="M12 2V5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                        <path
                          d="M12 19V22"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                        <path
                          d="M12 19C15.866 19 19 15.866 19 12C19 8.13401 15.866 5 12 5C8.13401 5 5 8.13401 5 12C5 15.866 8.13401 19 12 19Z"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </button>
                  <button
                    type="button"
                    class="dl-page__locator-input-clear"
                    aria-label="Clear search"
                    hidden
                    data-dl-zip-clear
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 4L4 12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                      <path
                        d="M4 4L12 12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </button>
                  <p
                    id="dl-search-inline-error"
                    class="dl-page__search-inline-error"
                    hidden
                    role="alert"
                  >
                  </p>
                </div>

                <div
                  class="dl-page__locator-within"
                  role="group"
                  aria-labelledby="dl-within-label"
                >
                  <span
                    class="dl-page__locator-within-label"
                    id="dl-within-label">Within</span
                  >
                  <div class="dl-page__radius-chips" data-dl-radius-group>
                    {
                      ["10", "25", "50", "100", "200", "500", "any"].map(
                        (mi, i) => (
                          <label class="dl-page__radius-chip">
                            <input
                              type="radio"
                              name="dl-radius"
                              value={mi}
                              checked={i === 0}
                              class="dl-page__radius-input visually-hidden"
                            />
                            <span class="dl-page__radius-chip-ui">
                              {mi === "any" ? "Any" : `${mi} mi`}
                            </span>
                          </label>
                        ),
                      )
                    }
                  </div>
                </div>

                <div class="dl-page__locator-category">
                  <label class="visually-hidden" for="dl-business-type"
                    >Category</label
                  >
                  <div class="dl-page__category-wrap" data-dl-business-root>
                    <button
                      type="button"
                      class="dl-page__category-trigger"
                      id="dl-business-trigger"
                      aria-label="Category"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="dl-business-menu"
                      data-dl-business-trigger
                    >
                      <span class="dl-page__category-prefix" aria-hidden="true"
                        >Category:</span
                      >
                      <span
                        id="dl-business-value"
                        class="dl-page__category-value"
                        data-dl-business-value>All</span
                      >
                      <span
                        class="dl-page__category-chevron"
                        aria-hidden="true"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="10"
                          height="6"
                          viewBox="0 0 10 6"
                          fill="none"
                        >
                          <path
                            d="M0.75 0.75L4.75 4.75L8.75 0.75"
                            stroke="#9C9C9C"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </span>
                    </button>
                    <ul
                      id="dl-business-menu"
                      class="dl-page__category-menu"
                      role="listbox"
                      aria-labelledby="dl-business-trigger"
                      hidden
                      data-dl-business-menu
                    >
                      <li role="presentation">
                        <button
                          type="button"
                          class="dl-page__category-option is-active"
                          role="option"
                          aria-selected="true"
                          data-dl-business-option="All"
                        >
                          All
                        </button>
                      </li>
                      <li role="presentation">
                        <button
                          type="button"
                          class="dl-page__category-option"
                          role="option"
                          aria-selected="false"
                          data-dl-business-option="Pool"
                        >
                          Pool
                        </button>
                      </li>
                      <li role="presentation">
                        <button
                          type="button"
                          class="dl-page__category-option"
                          role="option"
                          aria-selected="false"
                          data-dl-business-option="Spa"
                        >
                          Spa
                        </button>
                      </li>
                    </ul>
                    <select
                      id="dl-business-type"
                      class="visually-hidden"
                      name="businessType"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <option value="All" selected>All</option>
                      <option value="Pool">Pool</option>
                      <option value="Spa">Spa</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </form>

          <div
            id="dl-locator-message"
            class="dl-page__locator-message"
            hidden
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            <div class="dl-page__locator-message-inner">
              <span
                class="dl-page__locator-message-spinner"
                aria-hidden="true"
                hidden></span>
              <p class="dl-page__locator-message-text"></p>
            </div>
          </div>

          <div class="dl-page__locator-split">
            <div class="dl-page__locator-list-wrap">
              <ul
                class="dl-page__locator-results"
                id="dl-results-list"
                data-dl-results
              >
              </ul>
            </div>
            <div class="dl-page__locator-map-wrap" id="dl-map-wrap" hidden>
              <p
                id="dl-map-placeholder"
                class="dl-page__map-placeholder"
                role="status"
              >
                Map and pins appear after search.
              </p>
              <div
                id="dl-map"
                class="dl-page__locator-map"
                role="application"
                aria-label="Map of distributor locations"
              >
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <PageErrorToast id="dl-locator-error-toast" />
  </main>
</Layout>

<PageHeaderOffset />

<script>
  import "../../scripts/distributor-locator-page.ts";
</script>
