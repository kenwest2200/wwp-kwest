---
import Layout from "../../layouts/Layout.astro";
import PageHeaderOffset from "../../components/PageHeaderOffset.astro";
import SectionHero from "../../components/SectionHero/SectionHero.astro";

export const prerender = true;

const defaultZip =
  import.meta.env.PUBLIC_DISTRIBUTOR_LOCATOR_DEFAULT_ZIP?.trim() || "90210";
const mapsBrowserKey =
  import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY?.trim() ?? "";

const pageTitle = "Distributor locator";
const introDefault =
  "Find authorized distributors and dealers near you. Enter a ZIP code, choose a radius and category, then click Search to load the list and map.";
---

<Layout headerType="white" pageTitle={pageTitle} description={introDefault}>
  <main
    class="dl-page"
    data-page-header-offset
    data-dl-locator
    data-dl-maps-key={mapsBrowserKey}
  >
    <SectionHero title={pageTitle} intro={introDefault} />

    <div class="dl-page__body">
      <div class="dl-page__body-inner">
        <section
          class="dl-page__locator"
          aria-labelledby="dl-locator-heading"
          data-dl-tool
        >
          <h2 class="dl-page__locator-heading" id="dl-locator-heading">
            Search distributors
          </h2>

          <form
            class="dl-page__locator-form"
            id="dl-locator-form"
            autocomplete="postal-code"
            aria-label="Search distributors by ZIP code"
          >
            <div class="dl-page__locator-search-block">
              <label class="dl-page__locator-label" for="dl-zip-input"
                >Search by address / ZIP / city</label
              >
              <div class="dl-page__locator-search-row">
                <div class="dl-page__locator-input-wrap">
                  <span class="dl-page__locator-input-icon" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="M21 21l-4.3-4.3"></path>
                    </svg>
                  </span>
                  <input
                    id="dl-zip-input"
                    name="zip"
                    type="text"
                    class="dl-page__locator-input"
                    inputmode="numeric"
                    maxlength="10"
                    placeholder={`e.g. ${defaultZip}`}
                    aria-describedby="dl-locator-hint"
                    autocomplete="postal-code"
                  />
                </div>

                <div class="dl-page__locator-within" role="group" aria-labelledby="dl-within-label">
                  <span class="dl-page__locator-within-label" id="dl-within-label"
                    >Within</span
                  >
                  <div class="dl-page__radius-chips" data-dl-radius-group>
                    {
                      ["10", "25", "50", "100", "200", "500", "any"].map((mi, i) => (
                        <label class="dl-page__radius-chip">
                          <input
                            type="radio"
                            name="dl-radius"
                            value={mi}
                            checked={i === 0}
                            class="dl-page__radius-input visually-hidden"
                          />
                          <span class="dl-page__radius-chip-ui">
                            {mi === "any" ? "Any" : `${mi} mi`}
                          </span>
                        </label>
                      ))
                    }
                  </div>
                </div>

                <div class="dl-page__locator-category">
                  <label class="visually-hidden" for="dl-business-type">Category</label>
                  <div class="dl-page__category-wrap">
                    <span class="dl-page__category-prefix" aria-hidden="true"
                      >Category:</span
                    >
                    <select
                      id="dl-business-type"
                      class="dl-page__category-select"
                      name="businessType"
                    >
                      <option value="All">All</option>
                      <option value="Pool">Pool</option>
                      <option value="Spa">Spa</option>
                    </select>
                  </div>
                </div>

                <button type="submit" class="btn btn--primary-dark dl-page__locator-submit">
                  Search
                </button>
              </div>
              <p id="dl-locator-hint" class="dl-page__locator-hint">
                Enter a U.S. ZIP code (5 digits or ZIP+4), set radius and category if needed,
                then click Search. Results and the map appear after you search.
              </p>
            </div>
          </form>

          <p id="dl-locator-message" class="dl-page__locator-message" hidden role="alert"></p>

          <div class="dl-page__locator-split">
            <div class="dl-page__locator-list-wrap">
              <ul class="dl-page__locator-results" id="dl-results-list" data-dl-results></ul>
            </div>
            <div class="dl-page__locator-map-wrap">
              <p
                id="dl-map-placeholder"
                class="dl-page__map-placeholder"
                role="status"
              >
                Map and pins appear after you click Search.
              </p>
              <div
                id="dl-map"
                class="dl-page__locator-map"
                role="application"
                aria-label="Map of distributor locations"
              >
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />

<script>
  import "../../scripts/distributor-locator-page.ts";
</script>
