---
import Layout from "../layouts/Layout.astro";
import PageHeaderOffset from "../components/PageHeaderOffset.astro";
import "../styles/Pages/wp-generic-page.scss";
import type { WpGenericPagePathProps } from "../lib/queries/wp-generic-page";

export { getStaticPaths } from "../lib/wp-generic-page-static-paths";

export const prerender = true;

const { pageTitle, contentHtml } = Astro.props as WpGenericPagePathProps;
---

<Layout headerType="white" pageTitle={pageTitle}>
  <main class="wp-generic-page" data-wp-generic-page data-page-header-offset>
    <div class="wp-generic-page__inner">
      <h1 class="wp-generic-page__title">{pageTitle}</h1>
      <div class="wp-generic-page__content wysiwyg" set:html={contentHtml} />
    </div>
  </main>
</Layout>

<PageHeaderOffset />
