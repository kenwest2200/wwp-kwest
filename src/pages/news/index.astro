---
import Layout from "../../layouts/Layout.astro";
import PageHeaderOffset from "../../components/PageHeaderOffset.astro";
import SectionHero from "../../components/SectionHero/SectionHero.astro";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";
import ScrollToTopButton from "../../components/ScrollToTopButton/ScrollToTopButton.astro";
import { getGraphQLClient } from "../../lib/graphql";
import { fetchNewsPage } from "../../lib/queries/news-page";

export const prerender = true;

const graphqlConfigured = Boolean(getGraphQLClient());
const pageData = await fetchNewsPage();

const introDefault =
  "Catch up on what’s new at Waterway — from product releases and events to industry news and helpful updates.";

const pageTitle = pageData?.title?.trim() || "News";
const posts = pageData?.posts ?? [];
const hasPosts = posts.length > 0;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Company", href: "/company/" },
  { label: pageTitle },
];

function formatPostDate(iso: string | null): string {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return new Intl.DateTimeFormat("en-US", { dateStyle: "medium" }).format(d);
  } catch {
    return iso;
  }
}
---

<Layout
  headerType="white"
  bodyClass="is-news"
  pageTitle={pageTitle}
  description={introDefault}
>
  <main class="news-page" data-page-header-offset>
    <SectionHero title={pageTitle} intro={introDefault} customClass="news" />
    <div class="news-page__breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="news-page__body" aria-label="News">
      <div class="news-page__body-inner">
        {
          !graphqlConfigured && (
            <p class="news-page__notice">
              GraphQL is not configured. Set <code>PUBLIC_GRAPHQL_URL</code> in{" "}
              <code>.env</code>.
            </p>
          )
        }
        {
          graphqlConfigured && !pageData && (
            <p class="news-page__notice">
              Page not loaded for <code>/news/</code>.
            </p>
          )
        }

        {
          hasPosts ? (
            <ul class="news-page__grid">
              {posts.map((post) => (
                <li class="news-page__card">
                  <a class="news-page__card-link" href={post.href}>
                    <div class="news-page__card-body">
                      {post.date ? (
                        <p class="news-page__card-meta">
                          <time datetime={post.date}>
                            {formatPostDate(post.date)}
                          </time>
                        </p>
                      ) : null}
                      <div
                        class="news-page__card-caption"
                        set:html={post.titleHtml}
                      />
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ) : graphqlConfigured && pageData ? (
            <p class="news-page__empty">No news to show right now.</p>
          ) : null
        }
      </div>
    </section>

    <ScrollToTopButton />
  </main>
</Layout>

<PageHeaderOffset />
