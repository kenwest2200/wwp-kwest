---
import Layout from "../layouts/Layout.astro";
import PageHeaderOffset from "../components/PageHeaderOffset.astro";
import Four04Icon from "../components/icons/404icon.astro";

export const prerender = true;
---

<Layout headerType="white" pageTitle="Page not found" robotsNoIndex>
  <main class="page-404" data-404-page data-page-header-offset>
    <div class="page-404__inner">
      <div class="page-404__code" aria-hidden="true">
        <Four04Icon />
      </div>
      <h1 class="page-404__title">Page not found</h1>
      <p class="page-404__text">
        The page you’re looking for doesn’t exist or may have been moved.
      </p>
      <div class="page-404__actions">
        <a class="page-404__link page-404__link--ghost" href="/" data-404-back
          >Back to previous page</a
        >
        <a class="page-404__link page-404__link--primary" href="/">Go to Home</a
        >
      </div>
    </div>
  </main>
</Layout>

<PageHeaderOffset />

<script>
  const root = document.querySelector("[data-404-page]");
  root?.querySelector("[data-404-back]")?.addEventListener("click", (e) => {
    e.preventDefault();
    if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.assign("/");
    }
  });
</script>
