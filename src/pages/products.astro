---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import ScrollToTopButton from "../components/ScrollToTopButton/ScrollToTopButton.astro";
import { getGraphQLClient, requestGraphql } from "../lib/graphql";
import ProductFiltersIntro from "../components/ProductFilters/ProductFiltersIntro.astro";
import ProductFiltersRootNav from "../components/ProductFilters/ProductFiltersRootNav.astro";
import ProductFiltersPanel from "../components/ProductFilters/ProductFiltersPanel.astro";
import ProductFiltersResources from "../components/ProductFilters/ProductFiltersResources.astro";
import type { ProductFiltersRootNavBlock } from "../components/ProductFilters/types";
import {
  PRODUCTS_RESOURCES_QUERY,
  type ProductsResourcesData,
} from "../lib/queries/products-resources";

export const prerender = true;

const dataPath = path.join(
  process.cwd(),
  "public",
  "data",
  "product-filters.json",
);

const MAX_SUB_LINKS_PER_CARD = 6;

function buildRootNavBlocks(): ProductFiltersRootNavBlock[] {
  if (!fs.existsSync(dataPath)) {
    return [];
  }
  try {
    const raw = JSON.parse(fs.readFileSync(dataPath, "utf-8")) as {
      rootCategories?: { name: string; slug: string }[];
      mergedSubcategoryGroupsBySelection?: Record<
        string,
        {
          subcategories?: {
            slug: string;
            name: string;
            uri?: string | null;
          }[];
        }[]
      >;
    };
    const merged = raw.mergedSubcategoryGroupsBySelection ?? {};
    const roots = (raw.rootCategories ?? []).slice(0, 3);

    return roots.map((root) => {
      const groups = merged[root.slug] ?? [];
      const seen = new Set<string>();
      const subLinks: { name: string; href: string }[] = [];

      for (const g of groups) {
        for (const s of g.subcategories ?? []) {
          if (!s?.slug || seen.has(s.slug)) continue;
          seen.add(s.slug);
          const href = `?category=${encodeURIComponent(root.slug)}&sub=${encodeURIComponent(s.slug)}`;
          subLinks.push({ name: s.name, href });
          if (subLinks.length >= MAX_SUB_LINKS_PER_CARD) break;
        }
        if (subLinks.length >= MAX_SUB_LINKS_PER_CARD) break;
      }

      return {
        rootName: root.name,
        rootSlug: root.slug,
        subLinks,
        filterHref: `?category=${encodeURIComponent(root.slug)}`,
      };
    });
  } catch {
    return [];
  }
}

const rootNavBlocks = buildRootNavBlocks();
let resourcesData: ProductsResourcesData | null = null;
if (getGraphQLClient()) {
  try {
    resourcesData = await requestGraphql<ProductsResourcesData>(
      PRODUCTS_RESOURCES_QUERY,
    );
  } catch {
    resourcesData = null;
  }
}
---

<Layout>
  <main class="product-filters-page">
    <ProductFiltersIntro hasRootNav={rootNavBlocks.length > 0} />
    <ProductFiltersRootNav blocks={rootNavBlocks} />
    <ProductFiltersPanel />
    <ProductFiltersResources data={resourcesData} />
    <ScrollToTopButton />
  </main>
</Layout>

<script>
  import "../scripts/product-filters-page.ts";
</script>
