---
import Layout from "../../layouts/Layout.astro";
import ProductSingleTemplateBlock from "../../components/Product/ProductSingleTemplateBlock.astro";
import "../../styles/Pages/product-page.scss";
import { ClientError } from "graphql-request";
import { getGraphQLClient, requestGraphql } from "../../lib/graphql";
import {
  normalizeSingleTemplateOptionalItems,
  normalizeSupportLinks,
  relatedPartsHtmlFromApi,
  PRODUCT_PAGE_QUERY_BY_DATABASE_ID,
  PRODUCT_PAGE_QUERY_MINIMAL_BY_DATABASE_ID,
  PRODUCT_PAGE_QUERY_MINIMAL_SLUG,
  PRODUCT_PAGE_QUERY_SLUG,
  PRODUCT_PAGE_QUERY_URI,
  type ProductPageData,
} from "../../lib/queries/product-detail";
import type { ProductPagePathProps } from "../../lib/product-static-paths";

export { getStaticPaths } from "../../lib/product-static-paths";

export const prerender = true;

const slug = Astro.params.slug ?? "";

interface Props extends Partial<ProductPagePathProps> {}

const {
  databaseId: catalogDatabaseId = null,
  catalogTitle: catalogTitleProp = "",
} = Astro.props;
const databaseIdFromCatalog =
  typeof catalogDatabaseId === "number" && catalogDatabaseId > 0
    ? catalogDatabaseId
    : null;

const graphqlConfigured = Boolean(getGraphQLClient());

async function tryLoadProduct(
  document: string,
  variables: Record<string, unknown>,
): Promise<ProductPageData["product"] | null> {
  try {
    const data = (await requestGraphql(document, variables)) as ProductPageData;
    return data.product ?? null;
  } catch (e) {
    if (e instanceof ClientError) {
      const resp = e.response as {
        data?: ProductPageData;
        errors?: { message?: string }[];
      };
      const partial = resp.data?.product ?? null;
      if (partial) {
        if (import.meta.env.DEV && resp.errors?.length) {
          console.warn(
            "[product-page] GraphQL returned errors; using partial product data:",
            resp.errors.map((x) => x.message).filter(Boolean).join(" | "),
          );
        }
        return partial;
      }
      if (import.meta.env.DEV) {
        console.warn(
          "[product-page] GraphQL error:",
          resp.errors?.[0]?.message ?? e.message,
        );
      }
      return null;
    }
    if (import.meta.env.DEV) {
      console.warn("[product-page] GraphQL request failed:", e);
    }
    return null;
  }
}

let product: ProductPageData["product"] | null = null;
const databaseIdsAlreadyTried = new Set<number>();
if (graphqlConfigured && slug) {
  if (databaseIdFromCatalog != null) {
    databaseIdsAlreadyTried.add(databaseIdFromCatalog);
    product = await tryLoadProduct(PRODUCT_PAGE_QUERY_BY_DATABASE_ID, {
      id: String(databaseIdFromCatalog),
    });
  }
  if (!product) {
    product = await tryLoadProduct(PRODUCT_PAGE_QUERY_SLUG, { id: slug });
  }
  if (!product) {
    for (const uri of [`/product/${slug}/`, `/product/${slug}`]) {
      product = await tryLoadProduct(PRODUCT_PAGE_QUERY_URI, { id: uri });
      if (product) break;
    }
  }
  if (!product && slug) {
    let sparse = await tryLoadProduct(PRODUCT_PAGE_QUERY_MINIMAL_SLUG, {
      id: slug,
    });
    if (!sparse && databaseIdFromCatalog != null) {
      sparse = await tryLoadProduct(PRODUCT_PAGE_QUERY_MINIMAL_BY_DATABASE_ID, {
        id: String(databaseIdFromCatalog),
      });
    }
    const sparseId =
      typeof sparse?.databaseId === "number" && sparse.databaseId > 0
        ? sparse.databaseId
        : null;
    if (sparse && sparseId != null && !databaseIdsAlreadyTried.has(sparseId)) {
      databaseIdsAlreadyTried.add(sparseId);
      const fullByResolvedId = await tryLoadProduct(
        PRODUCT_PAGE_QUERY_BY_DATABASE_ID,
        { id: String(sparseId) },
      );
      product = fullByResolvedId ?? sparse;
    } else if (sparse) {
      product = sparse;
    }
  }
}

const title =
  product?.title?.trim() ||
  catalogTitleProp.trim() ||
  (slug ? slug.replace(/-/g, " ") : "Product");

const images = product?.productSettings?.productImagesGroup;
const mainImg = images?.productImagesMain?.node;
const brandImg = images?.productImagesBrand?.node;
const specGroup = product?.productSettings?.productSpecificationGroup;
const specHtml = specGroup?.productSpecification?.trim() ?? "";
const specSectionTitle =
  specGroup?.productSpecificationTitle?.trim() || "Specification";
const relatedPartsGroup =
  product?.productSettings?.productRelatedPartsGroup;
const relatedPartsTitle =
  relatedPartsGroup?.relatedPartsTitle?.trim() || "Replacement Parts";
const relatedPartsHtml = relatedPartsHtmlFromApi(
  relatedPartsGroup?.relatedParts,
);
const showRelatedSection = Boolean(relatedPartsHtml);
const supportGroup = product?.productSettings?.productSupportGroup;
const supportTitle = supportGroup?.productSupportTitle?.trim() ?? "";
const supportLinks = normalizeSupportLinks(
  supportGroup?.productSupportLinks ?? null,
);
const optionalItems = normalizeSingleTemplateOptionalItems(
  product?.productSettings?.singleTemplateGroup?.singleTemplateOptional,
);

function pushSlide(
  out: { src: string; alt: string }[],
  seen: { has(v: string): boolean; add(v: string): void },
  src?: string | null,
  alt?: string,
) {
  const u = src?.trim();
  if (!u || seen.has(u)) return;
  seen.add(u);
  out.push({ src: u, alt: alt ?? "" });
}

const gallerySlides: { src: string; alt: string }[] = [];
const seenGalleryUrls = new Set();
pushSlide(
  gallerySlides,
  seenGalleryUrls,
  mainImg?.sourceUrl,
  mainImg?.altText ?? title,
);
pushSlide(
  gallerySlides,
  seenGalleryUrls,
  brandImg?.sourceUrl,
  brandImg?.altText ?? "",
);
for (const item of optionalItems) {
  const nodes = item.singleTemplateOptionalGallery?.nodes ?? [];
  for (const n of nodes) {
    pushSlide(gallerySlides, seenGalleryUrls, n?.sourceUrl, n?.altText ?? "");
  }
}
---

<Layout headerType="white">
  <main class="product-page">
    <div class="product-page__inner">
      <div class="product-page__hero">
        <div class="product-page__hero-main">
          <h1 class="product-page__title">{title}</h1>
          <nav class="product-page__breadcrumb" aria-label="Breadcrumb">
            <ol class="product-page__breadcrumb-list">
              <li>
                <a href="/">Home</a>
              </li>
              <li>
                <a href="/products/">Products</a>
              </li>
              <li aria-current="page">{title}</li>
            </ol>
          </nav>
        </div>
        {
          brandImg?.sourceUrl && (
            <div class="product-page__hero-brand" aria-hidden="true">
              <img
                class="product-page__brand-logo"
                src={brandImg.sourceUrl}
                alt={brandImg.altText ?? ""}
                width={brandImg.mediaDetails?.width ?? undefined}
                height={brandImg.mediaDetails?.height ?? undefined}
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
      </div>

      {
        !product && (
          <p class="product-page__placeholder">
            {graphqlConfigured ? (
              <>
                No data from the API for slug <code>{slug}</code>. Check that
                the product exists in WordPress and that GraphQL can resolve it
                (slug, database ID, or URI <code>/product/{slug}/</code>).
              </>
            ) : (
              <>
                Product details are loaded from the GraphQL API. Set{" "}
                <code>PUBLIC_GRAPHQL_URL</code> in <code>.env</code> (see{" "}
                <code>.env.example</code>) and restart the dev server or rebuild.
              </>
            )}
          </p>
        )
      }

      {
        product && (
          <div class="product-page__body">
            {gallerySlides.length > 0 && (
              <section
                class="product-page__gallery-section"
                data-product-gallery
                aria-label="Product images"
              >
                <div class="product-page__gallery-frame">
                  <img
                    class="product-page__gallery-main-img"
                    src={gallerySlides[0].src}
                    alt={gallerySlides[0].alt || title}
                    width={mainImg?.mediaDetails?.width ?? undefined}
                    height={mainImg?.mediaDetails?.height ?? undefined}
                    loading="eager"
                    decoding="async"
                  />
                </div>
                {gallerySlides.length > 1 && (
                  <div class="product-page__gallery-thumbs-row">
                    <button
                      type="button"
                      class="product-page__gallery-arrow"
                      data-gallery-prev
                      aria-label="Previous image"
                    >
                      <span aria-hidden="true">‹</span>
                    </button>
                    <div class="product-page__gallery-thumbs">
                      {gallerySlides.map((slide, i) => (
                        <button
                          type="button"
                          class:list={[
                            "product-page__gallery-thumb",
                            i === 0 && "is-active",
                          ]}
                          data-full-src={slide.src}
                          data-full-alt={slide.alt}
                          aria-label={`Image ${i + 1} of ${gallerySlides.length}`}
                          aria-pressed={i === 0}
                        >
                          <img
                            src={slide.src}
                            alt=""
                            width="88"
                            height="88"
                            loading={i === 0 ? "eager" : "lazy"}
                            decoding="async"
                          />
                        </button>
                      ))}
                    </div>
                    <button
                      type="button"
                      class="product-page__gallery-arrow"
                      data-gallery-next
                      aria-label="Next image"
                    >
                      <span aria-hidden="true">›</span>
                    </button>
                  </div>
                )}
              </section>
            )}

            {optionalItems.map((item, idx) => (
              <ProductSingleTemplateBlock item={item} index={idx} />
            ))}

            {specHtml && (
              <section
                class="product-page__spec-section"
                aria-labelledby="product-spec-heading"
              >
                <h2 id="product-spec-heading" class="product-page__h2">
                  {specSectionTitle}
                </h2>
                <div class="product-page__spec" set:html={specHtml} />
              </section>
            )}

            {(supportTitle || supportLinks.length > 0) && (
              <section
                class="product-page__support"
                aria-labelledby="product-support-heading"
              >
                <h2 id="product-support-heading" class="product-page__h2">
                  {supportTitle || "Technical support"}
                </h2>
                {supportLinks.length > 0 && (
                  <ul class="product-page__link-list">
                    {supportLinks.map((link) => {
                      const href = link.url?.trim();
                      if (!href) return null;
                      const t = link.title?.trim() || href;
                      const blank =
                        link.target?.toLowerCase() === "_blank" ||
                        link.target?.toLowerCase() === "blank";
                      return (
                        <li>
                          <a
                            class="product-page__text-link"
                            href={href}
                            target={blank ? "_blank" : undefined}
                            rel={blank ? "noopener noreferrer" : undefined}
                          >
                            {t}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </section>
            )}

            {showRelatedSection && (
              <section
                class="product-page__related"
                aria-labelledby="product-related-heading"
              >
                <h2 id="product-related-heading" class="product-page__h2">
                  {relatedPartsTitle}
                </h2>
                <div
                  class="product-page__related-body"
                  set:html={relatedPartsHtml}
                />
              </section>
            )}
          </div>
        )
      }
    </div>
  </main>
</Layout>

<script>
  import "../../scripts/product-page-gallery.ts";
</script>
