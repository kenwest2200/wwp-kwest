---
import Layout from "../../layouts/Layout.astro";
import ProductPageMain from "../../components/Product/ProductPageMain.astro";
import "../../styles/Pages/product-page.scss";
import { getGraphQLClient } from "../../lib/graphql";
import { loadProductPageProduct } from "../../lib/product-page-load";
import { buildProductPageView } from "../../lib/product-page-view";
import type { ProductPagePathProps } from "../../lib/product-static-paths";

export { getStaticPaths } from "../../lib/product-static-paths";

export const prerender = true;

const slug = Astro.params.slug ?? "";

interface Props extends Partial<ProductPagePathProps> {}

const {
  databaseId: catalogDatabaseId = null,
  catalogTitle: catalogTitleProp = "",
} = Astro.props;
const databaseIdFromCatalog =
  typeof catalogDatabaseId === "number" && catalogDatabaseId > 0
    ? catalogDatabaseId
    : null;

const graphqlConfigured = Boolean(getGraphQLClient());
const product = await loadProductPageProduct({
  slug,
  catalogDatabaseId: databaseIdFromCatalog,
});
const view = buildProductPageView(product, {
  slug,
  catalogTitle: catalogTitleProp,
});
---

<Layout headerType="white">
  <ProductPageMain
    graphqlConfigured={graphqlConfigured}
    slug={slug}
    product={product}
    view={view}
  />
</Layout>

<script>
  import "../../scripts/product-page-gallery.ts";
  import "../../scripts/product-page-accordion.ts";
  import "../../scripts/product-page-spec-table.ts";
</script>
