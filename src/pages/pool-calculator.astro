---
import Layout from "../layouts/Layout.astro";
import PageHeaderOffset from "../components/PageHeaderOffset.astro";
import ScrollToTopButton from "../components/ScrollToTopButton/ScrollToTopButton.astro";
import shapeRectangle from "../assets/images/shapes/rectangle.png";
import shapeCircle from "../assets/images/shapes/circle.png";
import shapeOval from "../assets/images/shapes/oval.png";
import shapeOblong from "../assets/images/shapes/oblong.png";
import shapeKidney from "../assets/images/shapes/kidney.png";
import IconArrowRight from "../components/icons/IconArrowRight.astro";

export const prerender = true;

const pageTitle = "Pool volume and flow rate calculator";
const intro =
  "Use this tool to estimate water volume, determine proper flow rate, and ensure your pool equipment is sized correctly for optimal performance.";
---

<Layout headerType="white" pageTitle={pageTitle} description={intro}>
  <main class="pool-calc" data-pool-calculator data-page-header-offset>
    <section class="pool-calc__hero" aria-labelledby="pool-calc-hero-title">
      <div class="pool-calc__hero-inner">
        <img
          class="pool-calc__hero-img"
          src="/images/2.jpg"
          width="120"
          height="80"
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="pool-calc__hero-text">
          <h1 class="pool-calc__hero-title" id="pool-calc-hero-title">
            {pageTitle}
          </h1>
          <p class="pool-calc__hero-intro">{intro}</p>
        </div>
      </div>
    </section>

    <div class="pool-calc__body">
      <div class="pool-calc__body-inner">
        <nav class="pool-calc__stepper" aria-label="Calculator steps">
          <div class="pool-calc__stepper-item" data-pool-stepper-index="1">
            <span class="pool-calc__stepper-num" aria-hidden="true">1</span>
            <span class="pool-calc__stepper-label"
              >Select pool configuration</span
            >
          </div>
          <div class="pool-calc__stepper-line" aria-hidden="true"></div>
          <div class="pool-calc__stepper-item" data-pool-stepper-index="2">
            <span class="pool-calc__stepper-num" aria-hidden="true">2</span>
            <span class="pool-calc__stepper-label">Calculate pool volume</span>
          </div>
          <div class="pool-calc__stepper-line" aria-hidden="true"></div>
          <div class="pool-calc__stepper-item" data-pool-stepper-index="3">
            <span class="pool-calc__stepper-num" aria-hidden="true">3</span>
            <span class="pool-calc__stepper-label"
              >Calculate gallons / minute</span
            >
          </div>
        </nav>

        <div class="pool-calc__panels" id="pool-calc-panels-viewport">
        <div class="pool-calc__panel" data-pool-panel="1">
          <h2 class="pool-calc__panel-title">Select a pool shape</h2>
          <div class="pool-calc__shape-grid">
            <button
              type="button"
              class="pool-calc__shape-card"
              data-shape="rectangle"
            >
              <span class="pool-calc__shape-name">Rectangle</span>
              <img
                class="pool-calc__shape-icon"
                src={shapeRectangle.src}
                width={shapeRectangle.width}
                height={shapeRectangle.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
            <button
              type="button"
              class="pool-calc__shape-card"
              data-shape="circle"
            >
              <span class="pool-calc__shape-name">Circle</span>
              <img
                class="pool-calc__shape-icon"
                src={shapeCircle.src}
                width={shapeCircle.width}
                height={shapeCircle.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
            <button
              type="button"
              class="pool-calc__shape-card"
              data-shape="oval"
            >
              <span class="pool-calc__shape-name">Oval</span>
              <img
                class="pool-calc__shape-icon"
                src={shapeOval.src}
                width={shapeOval.width}
                height={shapeOval.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
            <button
              type="button"
              class="pool-calc__shape-card"
              data-shape="oblong"
            >
              <span class="pool-calc__shape-name">Oblong</span>
              <img
                class="pool-calc__shape-icon"
                src={shapeOblong.src}
                width={shapeOblong.width}
                height={shapeOblong.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
            <button
              type="button"
              class="pool-calc__shape-card"
              data-shape="kidney"
            >
              <span class="pool-calc__shape-name">Kidney</span>
              <img
                class="pool-calc__shape-icon"
                src={shapeKidney.src}
                width={shapeKidney.width}
                height={shapeKidney.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
          </div>
        </div>

        <div class="pool-calc__panel" data-pool-panel="2" hidden>
          <h2 class="pool-calc__panel-title">Estimate your pool volume</h2>
          <div class="pool-calc__badge-wrap">
            <p class="pool-calc__badge pool-calc__js-shape-badge" hidden>
              <span class="pool-calc__js-shape-badge-label"
                >Selected shape:</span
              >
              <span class="pool-calc__js-shape-badge-value"></span>
            </p>
          </div>
          <div
            id="pool-calc-step2-viewport"
            class="pool-calc__step2-viewport"
          >
            <div id="pool-calc-dimensions" class="pool-calc__dimensions">
              <div
                id="pool-calc-dimensions-fields"
                class="pool-calc__dimensions-fields"
              >
              </div>
              <div
                id="pool-calc-step2-actions"
                class="pool-calc__inline-actions"
                hidden
              >
                <button
                  type="button"
                  class="btn pool-calc__btn-outline"
                  id="pool-calc-clear-dim"
                >
                  Clear all
                </button>
                <button
                  type="button"
                  class="btn btn--primary-dark pool-calc__btn-solid"
                  id="pool-calc-estimate-volume"
                >
                  Estimate volume
                </button>
              </div>
            </div>
            <div
              id="pool-calc-step2-result"
              class="pool-calc__result-card"
              hidden
            >
              <p class="pool-calc__result-line">
                Your pool volume: <strong id="pool-calc-volume-result">0</strong> Gallons
              </p>
              <button
                type="button"
                class="btn pool-calc__btn-outline"
                id="pool-calc-try-again">Try again</button
              >
            </div>
          </div>
        </div>

        <div class="pool-calc__panel" data-pool-panel="4" hidden>
          <h2 class="pool-calc__panel-title">Estimate your GPM</h2>
          <div class="pool-calc__badge-wrap">
            <p
              class="pool-calc__badge pool-calc__js-shape-badge"
              aria-live="polite"
              hidden
            >
              <span class="pool-calc__js-shape-badge-label"
                >Selected shape:</span
              >
              <span class="pool-calc__js-shape-badge-value"></span>
            </p>
          </div>
          <div class="pool-calc__dimensions pool-calc__dimensions--gpm">
            <div class="pool-calc__dimensions-fields">
              <div class="pool-calc__dim-row">
                <div class="pool-calc__dim-label-wrap">
                  <span class="pool-calc__dim-label"
                    >Pool volume<span class="pool-calc__dim-req" aria-hidden="true"
                      >*</span
                    ></span
                  >
                </div>
                <div class="pool-calc__dim-inputs pool-calc__dim-inputs--gpm-full">
                  <label class="pool-calc__dim-field pool-calc__dim-field--stretch">
                    <div class="pool-calc__dim-control pool-calc__dim-control--gpm-volume">
                      <input
                        type="text"
                        inputmode="numeric"
                        id="pool-calc-volume-input"
                        autocomplete="off"
                        aria-label="Pool volume in gallons"
                      />
                      <span class="pool-calc__dim-unit">Gallons</span>
                    </div>
                  </label>
                </div>
              </div>
              <div class="pool-calc__dim-row">
                <div class="pool-calc__dim-label-wrap">
                  <span class="pool-calc__dim-label">Turnovers per day</span>
                </div>
                <div class="pool-calc__dim-inputs pool-calc__dim-inputs--gpm-full">
                  <div
                    id="pool-calc-turnovers-root"
                    class="product-filters__custom-select"
                    data-pool-turnover-root
                  >
                    <button
                      type="button"
                      id="pool-calc-turnovers-trigger"
                      class="product-filters__custom-select-trigger"
                      aria-label="Turnovers per day"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="pool-calc-turnovers-menu"
                      data-pool-turnover-trigger
                    >
                      <span class="product-filters__custom-select-text">
                        <span class="product-filters__custom-select-fixed"
                          >Turnovers:</span
                        >
                        <span
                          id="pool-calc-turnovers-value"
                          class="product-filters__custom-select-variable">1</span
                        >
                        <span class="product-filters__custom-select-variable"
                          >× / day</span
                        >
                      </span>
                      <span
                        class="product-filters__custom-select-chevron"
                        aria-hidden="true"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="10"
                          height="6"
                          viewBox="0 0 10 6"
                          fill="none"
                        >
                          <path
                            d="M0.75 0.75L4.75 4.75L8.75 0.75"
                            stroke="#9C9C9C"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        </svg>
                      </span>
                    </button>
                    <ul
                      id="pool-calc-turnovers-menu"
                      class="product-filters__custom-select-menu"
                      role="listbox"
                      aria-labelledby="pool-calc-turnovers-trigger"
                      hidden
                      data-pool-turnover-menu
                    >
                      {
                        [1, 2, 3, 4, 5, 6].map((n) => (
                          <li role="presentation">
                            <button
                              type="button"
                              class="product-filters__custom-select-option"
                              role="option"
                              data-pool-turnover-value={String(n)}
                              aria-selected={n === 1 ? "true" : "false"}
                            >
                              {n}
                            </button>
                          </li>
                        ))
                      }
                    </ul>
                    <select
                      id="pool-calc-turnovers"
                      class="visually-hidden"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                      <option value="5">5</option>
                      <option value="6">6</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
            <div
              id="pool-calc-step4-actions"
              class="pool-calc__inline-actions"
              hidden
            >
              <button
                type="button"
                class="btn pool-calc__btn-outline"
                id="pool-calc-clear-gpm">Clear all</button
              >
              <button
                type="button"
                class="btn btn--primary-dark pool-calc__btn-solid"
                id="pool-calc-estimate-gpm"
              >
                Estimate GPM
              </button>
            </div>
          </div>
        </div>

        <div class="pool-calc__panel" data-pool-panel="5" hidden>
          <h2 class="pool-calc__panel-title">Calculation results</h2>
          <div class="pool-calc__badges-row">
            <p id="pool-calc-final-shape" class="pool-calc__badge">
              <span class="pool-calc__js-shape-badge-label">Selected shape:</span>
              <span class="pool-calc__js-shape-badge-value"></span>
            </p>
            <p id="pool-calc-final-turnover" class="pool-calc__badge">
              <span class="pool-calc__js-shape-badge-label">Turnover:</span>
              <span class="pool-calc__js-shape-badge-value"></span>
            </p>
          </div>
          <div class="pool-calc__result-card pool-calc__result-card--wide">
            <p class="pool-calc__result-line">
              Your pool volume: <strong id="pool-calc-final-volume">0</strong> Gallons
            </p>
            <p class="pool-calc__result-line">
              Your gallons per minute: <strong id="pool-calc-final-gpm"
                >0.0</strong
              > GPM
            </p>
            <button
              type="button"
              class="btn pool-calc__btn-outline"
              id="pool-calc-try-again-final">Try again</button
            >
          </div>

          <h3 class="pool-calc__parts-title">Find below suitable parts</h3>
          <div class="pool-calc__accordion">
            <div
              class="pool-calc__accordion-item"
              data-pool-calc-category-slug="pool-pumps-in-ground"
            >
              <button
                type="button"
                class="pool-calc__accordion-btn"
                aria-expanded="false"
              >
                <span>In Ground Pool Pumps</span>
                <span class="pool-calc__accordion-icon" aria-hidden="true"
                  >+</span
                >
              </button>
              <div class="pool-calc__accordion-panel" hidden></div>
            </div>
            <div
              class="pool-calc__accordion-item"
              data-pool-calc-category-slug="pool-filters-in-ground-above-ground"
            >
              <button
                type="button"
                class="pool-calc__accordion-btn"
                aria-expanded="false"
              >
                <span>In Ground Filters</span>
                <span class="pool-calc__accordion-icon" aria-hidden="true"
                  >+</span
                >
              </button>
              <div class="pool-calc__accordion-panel" hidden></div>
            </div>
            <div
              class="pool-calc__accordion-item"
              data-pool-calc-category-slug="pool-skimmers-skim-filters"
            >
              <button
                type="button"
                class="pool-calc__accordion-btn"
                aria-expanded="false"
              >
                <span>Pool Skimmers and Skimmer Filters</span>
                <span class="pool-calc__accordion-icon" aria-hidden="true"
                  >+</span
                >
              </button>
              <div class="pool-calc__accordion-panel" hidden></div>
            </div>
            <div
              class="pool-calc__accordion-item"
              data-pool-calc-category-slug="drains-suctions"
            >
              <button
                type="button"
                class="pool-calc__accordion-btn"
                aria-expanded="false"
              >
                <span>Drains and Suctions</span>
                <span class="pool-calc__accordion-icon" aria-hidden="true"
                  >+</span
                >
              </button>
              <div class="pool-calc__accordion-panel" hidden></div>
            </div>
          </div>
        </div>
        </div>

        <div class="pool-calc__footer-actions" id="pool-calc-footer">
          <div class="pool-calc__footer-left">
            <button
              type="button"
              class="btn pool-calc__btn-outline"
              id="pool-calc-btn-prev"
              hidden
            >
              <IconArrowRight /> Previous step
            </button>
          </div>
          <div class="pool-calc__footer-right">
            <button
              type="button"
              class="btn btn--primary-dark pool-calc__btn-solid"
              id="pool-calc-btn-next"
            >
              <span
                id="pool-calc-btn-next-text"
                class="pool-calc__btn-next-text"
              >
                Next step
                <IconArrowRight />
              </span>
            </button>
            <button
              type="button"
              class="btn btn--primary-dark pool-calc__btn-solid"
              id="pool-calc-btn-finish"
              hidden
            >
              Finish calculation
            </button>
          </div>
        </div>
      </div>
    </div>

    <ScrollToTopButton />
  </main>

  <PageHeaderOffset />

  <script>
    import { initPoolCalculator } from "../scripts/pool-calculator-page.ts";
    initPoolCalculator();
  </script>
</Layout>
