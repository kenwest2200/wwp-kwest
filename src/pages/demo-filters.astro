---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout>
  <main class="demo-filters-page">
    <div class="demo-filters__layout">
      <section
        class="demo-filters__panel"
        aria-labelledby="demo-filters-heading"
      >
        <h1 id="demo-filters-heading" class="demo-filters__h1">Demo filters</h1>
        <p id="demo-filters-api-error" class="demo-filters__err" hidden></p>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Categories</h3>
          <div id="demo-filters-root" class="demo-filters__chips"></div>
        </div>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Product types</h3>
          <div id="demo-filters-sub" class="demo-filters__chips"></div>
        </div>

        <div class="demo-filters__group">
          <h3 class="demo-filters__group-title">Base attributes</h3>
          <div id="demo-filters-attrs" class="demo-filters__chips"></div>
        </div>

        <button type="button" id="demo-filters-clear" class="demo-filters__btn">
          Clear all
        </button>

        <p class="demo-filters__meta">
          <span id="demo-filters-count"></span>
        </p>
      </section>

      <section class="demo-filters__panel" aria-labelledby="demo-products-h">
        <h2 id="demo-products-h" class="demo-filters__h2">Products</h2>
        <p
          id="demo-filters-products-total"
          class="demo-filters__products-total"
        >
          Products found: 0
        </p>
        <ul id="demo-filters-products" class="demo-filters__list"></ul>
        <div class="demo-filters__pager">
          <button
            type="button"
            id="demo-filters-prev"
            class="demo-filters__btn"
          >
            Prev
          </button>
          <span id="demo-filters-page" class="demo-filters__page-indicator"
            >Page 1</span
          >
          <button
            type="button"
            id="demo-filters-next"
            class="demo-filters__btn"
          >
            Next
          </button>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  :global(.demo-filters-page) {
    background: linear-gradient(180deg, #007d8a 0%, #00aec7 100%);
    padding: 8rem 0 4rem;
  }
  :global(.demo-filters__layout) {
    display: grid;
    grid-template-columns: 300px 1fr;
    padding: 0 1rem;
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }

  :global(.demo-filters__panel) {
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 1rem;
    background: #fff;
  }
  :global(.demo-filters__h1),
  :global(.demo-filters__h2) {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  :global(.demo-filters__err) {
    color: #b00020;
    font-size: 0.8125rem;
    margin: 0 0 0.75rem;
  }
  :global(.demo-filters__group) {
    margin-bottom: 1rem;
  }
  :global(.demo-filters__group-title) {
    margin: 0 0 0.4rem;
    font-size: 0.875rem;
    color: #444;
  }
  :global(.demo-filters__chips) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 2rem;
  }
  :global(.demo-filters__chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.8125rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: #f5f5f5;
    cursor: pointer;
  }
  :global(.demo-filters__chip:has(input:checked)) {
    border-color: #007d8a;
    background: #e6f4f5;
    font-weight: 600;
  }
  :global(.demo-filters__chip-input) {
    margin: 0;
  }
  :global(.demo-filters__btn) {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  :global(.demo-filters__meta) {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: #666;
  }
  :global(.demo-filters__products-total) {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    color: #444;
  }
  :global(.demo-filters__pager) {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.demo-filters__page-indicator) {
    font-size: 0.8125rem;
    color: #444;
  }
  :global(.demo-filters__list) {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(200px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  :global(.demo-filters__list li) {
    padding: 0.35rem 0;
    border: 1px solid #eee;
    font-size: 0.875rem;
  }
</style>

<script>
  const rootEl = document.getElementById("demo-filters-root");
  const subEl = document.getElementById("demo-filters-sub");
  const attrsEl = document.getElementById("demo-filters-attrs");
  const productsEl = document.getElementById("demo-filters-products");
  const productsTotalEl = document.getElementById(
    "demo-filters-products-total",
  );
  const prevBtn = document.getElementById("demo-filters-prev");
  const nextBtn = document.getElementById("demo-filters-next");
  const pageEl = document.getElementById("demo-filters-page");
  const clearBtn = document.getElementById("demo-filters-clear");
  const errEl = document.getElementById("demo-filters-api-error");
  const countEl = document.getElementById("demo-filters-count");

  const selectedRoot = new Set<string>();
  const selectedSub = new Set<string>();
  const selectedAttrs = new Set<string>();
  let allProducts: Array<{
    title: string;
    slug: string;
    categorySlugs: string[];
    attributeSlugs: string[];
  }> = [];
  let rootMap = new Map<string, { name: string; slug: string }[]>();
  const rootChildrenMap = new Map<string, string[]>();
  const PAGE_SIZE = 24;
  let currentOffset = 0;
  let currentTotal = 0;

  function parseListParam(params: URLSearchParams, key: string) {
    const raw = params.get(key);
    if (!raw) return [];
    return raw
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean);
  }

  function applyStateFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const roots = parseListParam(params, "root");
    const sub = parseListParam(params, "sub");
    const attr = parseListParam(params, "attr");
    const page = Number(params.get("page") ?? "1");

    selectedRoot.clear();
    selectedSub.clear();
    selectedAttrs.clear();

    roots.forEach((s) => selectedRoot.add(s));
    sub.forEach((s) => selectedSub.add(s));
    attr.forEach((s) => selectedAttrs.add(s));

    const safePage = Number.isFinite(page) ? Math.max(1, Math.floor(page)) : 1;
    currentOffset = (safePage - 1) * PAGE_SIZE;
  }

  function syncUrlState() {
    const params = new URLSearchParams(window.location.search);
    const roots = [...selectedRoot];
    const sub = [...selectedSub];
    const attr = [...selectedAttrs];
    const page = Math.floor(currentOffset / PAGE_SIZE) + 1;

    if (roots.length > 0) params.set("root", roots.join(","));
    else params.delete("root");

    if (sub.length > 0) params.set("sub", sub.join(","));
    else params.delete("sub");

    if (attr.length > 0) params.set("attr", attr.join(","));
    else params.delete("attr");

    if (page > 1) params.set("page", String(page));
    else params.delete("page");

    const qs = params.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState(null, "", url);
  }

  function setError(text: string | null) {
    if (!errEl) return;
    if (text) {
      errEl.textContent = text;
      errEl.hidden = false;
    } else {
      errEl.textContent = "";
      errEl.hidden = true;
    }
  }

  function setLoading(on: boolean) {
    if (clearBtn instanceof HTMLButtonElement) clearBtn.disabled = on;
    if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = on;
    if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = on;
    [rootEl, subEl, attrsEl].forEach((el) => {
      if (!el) return;
      el.querySelectorAll<HTMLInputElement>("input[type='checkbox']").forEach(
        (input) => {
          input.disabled = on;
        },
      );
    });
  }

  function escapeHtml(s: string) {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function refreshAllSet() {
    // Kept for backward compatibility with previous flow.
  }

  function renderSubcategories() {
    if (!subEl) return;
    const selectedRoots = [...selectedRoot];
    const list =
      selectedRoots.length > 0
        ? selectedRoots.flatMap((slug) => rootMap.get(slug) ?? [])
        : [...rootMap.values()].flat();
    const uniqueBySlug = new Map(list.map((item) => [item.slug, item]));
    subEl.innerHTML = [...uniqueBySlug.values()]
      .map(
        (a) =>
          `<label class="demo-filters__chip"><input class="demo-filters__chip-input" type="checkbox" data-group="sub" data-slug="${escapeHtml(a.slug)}" />${escapeHtml(a.name)}</label>`,
      )
      .join("");
    syncCheckboxes();
  }

  function syncPager() {
    const page = Math.floor(currentOffset / PAGE_SIZE) + 1;
    const totalPages = Math.max(1, Math.ceil(currentTotal / PAGE_SIZE));
    if (pageEl) {
      pageEl.textContent = `Page ${page} of ${totalPages}`;
    }
    if (prevBtn instanceof HTMLButtonElement) {
      prevBtn.disabled = currentOffset <= 0;
    }
    if (nextBtn instanceof HTMLButtonElement) {
      nextBtn.disabled = currentOffset + PAGE_SIZE >= currentTotal;
    }
  }

  async function readJsonSafe(res: Response) {
    const text = await res.text();
    if (!text) {
      throw new Error(`Empty response body (HTTP ${res.status})`);
    }
    try {
      return JSON.parse(text) as unknown;
    } catch {
      throw new Error(
        `Non-JSON response (HTTP ${res.status}): ${text.slice(0, 200)}`,
      );
    }
  }

  function filterProducts() {
    const selectedRootSlugs = [...selectedRoot];
    const selectedSubSlugs = [...selectedSub];
    const selectedAttrSlugs = [...selectedAttrs];
    const hasNoFilters =
      selectedRootSlugs.length === 0 &&
      selectedSubSlugs.length === 0 &&
      selectedAttrSlugs.length === 0;
    if (hasNoFilters) {
      return allProducts;
    }
    const rootScope = new Set<string>();
    selectedRootSlugs.forEach((rootSlug) => {
      rootScope.add(rootSlug);
      (rootChildrenMap.get(rootSlug) ?? []).forEach((slug) => rootScope.add(slug));
    });
    const scopedSelectedSubSlugs =
      rootScope.size > 0
        ? selectedSubSlugs.filter((slug) => rootScope.has(slug))
        : selectedSubSlugs;

    return allProducts.filter((product) => {
      const categories = new Set(product.categorySlugs ?? []);
      const attrs = new Set(product.attributeSlugs ?? []);

      const rootMatch =
        rootScope.size === 0 || [...rootScope].some((slug) => categories.has(slug));
      if (!rootMatch) return false;

      const subMatch =
        scopedSelectedSubSlugs.length === 0 ||
        scopedSelectedSubSlugs.some((slug) => categories.has(slug));
      if (!subMatch) return false;

      const attrMatch =
        selectedAttrSlugs.length === 0 ||
        selectedAttrSlugs.some((slug) => attrs.has(slug));
      return attrMatch;
    });
  }

  async function fetchProducts() {
    setLoading(true);
    setError(null);
    refreshAllSet();
    syncUrlState();
    try {
      const filtered = filterProducts();
      const total = filtered.length;
      const items = filtered.slice(currentOffset, currentOffset + PAGE_SIZE);
      currentTotal = total;
      const start = total === 0 ? 0 : currentOffset + 1;
      const end = Math.min(currentOffset + PAGE_SIZE, total);
      if (productsTotalEl) {
        productsTotalEl.textContent = `Showing ${start}-${end} of ${total}`;
      }
      if (countEl) {
        const selectedCount =
          selectedRoot.size + selectedSub.size + selectedAttrs.size;
        countEl.textContent =
          selectedCount === 0
            ? `Total: ${total} (no filters selected)`
            : `Filters selected: ${selectedCount}. Found: ${total}`;
      }
      if (productsEl) {
        productsEl.innerHTML = items
          .map((p) => `<li>${escapeHtml(p.title)}</li>`)
          .join("");
      }
      syncPager();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setLoading(false);
    }
  }

  function syncCheckboxes() {
    [rootEl, subEl, attrsEl].forEach((el) => {
      if (!el) return;
      el.querySelectorAll<HTMLInputElement>("input[type='checkbox']").forEach(
        (input) => {
          const slug = input.dataset.slug;
          const group = input.dataset.group;
          if (!slug || !group) return;
          if (group === "root") input.checked = selectedRoot.has(slug);
          if (group === "sub") input.checked = selectedSub.has(slug);
          if (group === "attr") input.checked = selectedAttrs.has(slug);
        },
      );
    });
  }

  function renderGroup(
    el: HTMLElement | null,
    group: "root" | "attr",
    list: { name: string; slug: string }[],
  ) {
    if (!el) return;
    el.innerHTML = list
      .map(
        (a) =>
          `<label class="demo-filters__chip"><input class="demo-filters__chip-input" type="checkbox" data-group="${group}" data-slug="${escapeHtml(a.slug)}" />${escapeHtml(a.name)}</label>`,
      )
      .join("");
  }

  async function init() {
    try {
      const res = await fetch("/data/demo-filters.json");
      const data = (await readJsonSafe(res)) as {
        generatedAt?: string;
        attributes?: { name: string; slug: string }[];
        rootCategories?: {
          name: string;
          slug: string;
          subcategories: { name: string; slug: string }[];
        }[];
        products?: {
          title: string;
          slug: string;
          categorySlugs?: string[];
          attributeSlugs?: string[];
        }[];
      };
      console.log("[demo-filters] GET /data/demo-filters.json response", {
        status: res.status,
        ok: res.ok,
        body: data,
      });

      if (!rootEl || !subEl || !attrsEl) {
        console.error("[demo-filters] Static data load failed", {
          response: data,
          rootElExists: Boolean(rootEl),
          subElExists: Boolean(subEl),
          attrsElExists: Boolean(attrsEl),
        });
        setError("Failed to load static filter data");
        await fetchProducts();
        return;
      }

      const attrs = data.attributes ?? [];
      const roots = data.rootCategories ?? [];
      allProducts = (data.products ?? []).map((item) => ({
        title: item.title,
        slug: item.slug,
        categorySlugs: item.categorySlugs ?? [],
        attributeSlugs: item.attributeSlugs ?? [],
      }));
      rootMap = new Map(roots.map((r) => [r.slug, r.subcategories ?? []]));
      rootChildrenMap.clear();
      roots.forEach((root) => {
        rootChildrenMap.set(
          root.slug,
          (root.subcategories ?? []).map((sub) => sub.slug),
        );
      });
      applyStateFromUrl();

      renderGroup(rootEl, "root", roots);
      renderGroup(attrsEl, "attr", attrs.slice(0, 12));
      renderSubcategories();
      syncCheckboxes();

      const onChange = (e: Event) => {
        const input = (e.target as HTMLElement).closest<HTMLInputElement>(
          "input[type='checkbox'][data-group][data-slug]",
        );
        const slug = input?.dataset.slug;
        const group = input?.dataset.group;
        if (!input || !slug || !group) return;
        if (group === "root") {
          if (input.checked) selectedRoot.add(slug);
          else selectedRoot.delete(slug);
          renderSubcategories();
        } else if (group === "sub") {
          if (input.checked) selectedSub.add(slug);
          else selectedSub.delete(slug);
        } else if (group === "attr") {
          if (input.checked) selectedAttrs.add(slug);
          else selectedAttrs.delete(slug);
        }
        currentOffset = 0;
        syncCheckboxes();
        void fetchProducts();
      };

      rootEl.addEventListener("change", onChange);
      subEl.addEventListener("change", onChange);
      attrsEl.addEventListener("change", onChange);

      clearBtn?.addEventListener("click", () => {
        selectedRoot.clear();
        selectedSub.clear();
        selectedAttrs.clear();
        currentOffset = 0;
        renderSubcategories();
        syncCheckboxes();
        void fetchProducts();
      });

      prevBtn?.addEventListener("click", () => {
        if (currentOffset <= 0) return;
        currentOffset = Math.max(0, currentOffset - PAGE_SIZE);
        void fetchProducts();
      });

      nextBtn?.addEventListener("click", () => {
        if (currentOffset + PAGE_SIZE >= currentTotal) return;
        currentOffset += PAGE_SIZE;
        void fetchProducts();
      });

      window.addEventListener("popstate", () => {
        applyStateFromUrl();
        renderSubcategories();
        syncCheckboxes();
        void fetchProducts();
      });

      await fetchProducts();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    }
  }

  void init();
</script>
