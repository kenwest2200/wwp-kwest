---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import DemoFiltersIntro from "../components/DemoFilters/DemoFiltersIntro.astro";
import DemoFiltersRootNav from "../components/DemoFilters/DemoFiltersRootNav.astro";
import DemoFiltersPanel from "../components/DemoFilters/DemoFiltersPanel.astro";
import type { DemoFiltersRootNavBlock } from "../components/DemoFilters/types";

export const prerender = true;

const dataPath = path.join(
  process.cwd(),
  "public",
  "data",
  "demo-filters.json",
);

const MAX_SUB_LINKS_PER_CARD = 6;

function buildRootNavBlocks(): DemoFiltersRootNavBlock[] {
  if (!fs.existsSync(dataPath)) {
    return [];
  }
  try {
    const raw = JSON.parse(fs.readFileSync(dataPath, "utf-8")) as {
      rootCategories?: { name: string; slug: string }[];
      mergedSubcategoryGroupsBySelection?: Record<
        string,
        {
          subcategories?: {
            slug: string;
            name: string;
            uri?: string | null;
          }[];
        }[]
      >;
    };
    const merged = raw.mergedSubcategoryGroupsBySelection ?? {};
    const roots = (raw.rootCategories ?? []).slice(0, 3);

    return roots.map((root) => {
      const groups = merged[root.slug] ?? [];
      const seen = new Set<string>();
      const subLinks: { name: string; href: string }[] = [];

      for (const g of groups) {
        for (const s of g.subcategories ?? []) {
          if (!s?.slug || seen.has(s.slug)) continue;
          seen.add(s.slug);
          const href =
            s.uri?.trim() ||
            `?root=${encodeURIComponent(root.slug)}&sub=${encodeURIComponent(s.slug)}#demo-filters-catalog`;
          subLinks.push({ name: s.name, href });
          if (subLinks.length >= MAX_SUB_LINKS_PER_CARD) break;
        }
        if (subLinks.length >= MAX_SUB_LINKS_PER_CARD) break;
      }

      return {
        rootName: root.name,
        rootSlug: root.slug,
        subLinks,
        filterHref: `?root=${encodeURIComponent(root.slug)}#demo-filters-catalog`,
      };
    });
  } catch {
    return [];
  }
}

const rootNavBlocks = buildRootNavBlocks();
---

<Layout>
  <main class="demo-filters-page">
    <DemoFiltersIntro />
    <DemoFiltersRootNav blocks={rootNavBlocks} />
    <DemoFiltersPanel />
  </main>
</Layout>

<script>
  import "../scripts/demo-filters-page.ts";
</script>
