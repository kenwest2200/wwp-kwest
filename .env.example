PUBLIC_GRAPHQL_URL=https://your-api.example.com/graphql

# Distributor locator — Google Maps “browser” key (referrer restrictions in GCP).
# Local: .env + npm run dev (embeds into HTML).
# Production: `npm run build` runs on GitHub Actions — set secret OR variable PUBLIC_GOOGLE_MAPS_BROWSER_KEY
#   in the GitHub repo (Settings → Secrets and variables → Actions). Cloudflare UI variables do NOT run that build.
# Optional Worker secret (same key string): GOOGLE_MAPS_BROWSER_KEY → GET /api/maps-browser-key if HTML has no key.
PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Example ZIP for the locator input placeholder only (no auto-search on load)
PUBLIC_DISTRIBUTOR_LOCATOR_DEFAULT_ZIP=90210

# WordPress site origin (REST: /wp-json/restapi/v2/store-locations)
PUBLIC_WORDPRESS_ORIGIN=https://www.example.com

# Worker secret: Geocoding API key for /api/geocode-zip (ZIP centroid; not sent to the browser)
# GOOGLE_GEOCODING_KEY=

# Worker secret: Maps JS browser key for GET /api/maps-browser-key (use .dev.vars locally with wrangler dev)
# GOOGLE_MAPS_BROWSER_KEY=

# Basic Auth (not PUBLIC_* — not exposed in the client bundle)
GRAPHQL_BASIC_USER=api
GRAPHQL_BASIC_PASSWORD=apiwaterway
